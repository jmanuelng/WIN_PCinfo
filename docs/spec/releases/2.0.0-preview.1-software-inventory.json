  "collector": {
    "collectorId": "collector:windows.software-inventory",
    "collectorVersion": "1.0.0",
    "operationId": "observe-installed-software",
    "source": "Release-owned projection of explicit uninstall registry views, Windows Installer inventory APIs, and Windows package deployment identities",
    "executionContext": "StandardUser",
    "privilege": "NoElevation",
    "networkBehavior": "OfflineOnly",
    "executable": "MicrosoftWindowsPowerShellHost",
    "dependencies": ["Windows PowerShell 5.1", "Microsoft.Win32.Registry", "Windows Installer API", "Windows.Management.Deployment.PackageManager"],
    "mayPrompt": false,
    "mayInstall": false,
    "mayDownload": false,
    "maySelfElevate": false,
    "writesAllowed": false,
    "maximumAttempts": 1,
    "deadlineMilliseconds": 10000,
    "resultMaximumUtf8Bytes": 1048576,
    "maximumEntriesPerScope": 64,
    "maximumTotalEntries": 128,
    "cleanup": "CoordinatorOwnedJobObjectWorkerAndCompilerBoundaryVerifiedAbsent"
  },
  "sourceCatalog": [
    {
      "sourceId": "source:windows.registry.uninstall-registration",
      "interface": "Microsoft.Win32.RegistryKey.OpenBaseKey with explicit LocalMachine or CurrentUser and Registry32 or Registry64",
      "approvedProperties": ["RegistrationId", "DisplayName", "DisplayVersion", "Publisher", "WindowsInstaller", "SystemComponent"],
      "limitation": "ReadOnlyExactAssessmentUserOrMachineRegistrationMetadata"
    },
    {
      "sourceId": "source:windows.installer.product-inventory",
      "interface": "MsiEnumProductsExW and MsiGetProductInfoExW current-user and machine contexts",
      "approvedProperties": ["ProductCode", "InstallContext", "ProductState", "ProductName", "VersionString", "Publisher"],
      "limitation": "InventoryFunctionsOnlyNoConfigurationQueryOrProductAction"
    },
    {
      "sourceId": "source:windows.package-deployment.inventory",
      "interface": "Windows.Management.Deployment.PackageManager current-user and across-user package query",
      "approvedProperties": ["PackageFamilyName", "PackageFullName", "Name", "PublisherId", "Version", "Architecture", "PackageType", "Status"],
      "limitation": "StructuredIdentityOnlyNoContentPathBinaryCapabilityOrManifestInspection"
    }
  ],
