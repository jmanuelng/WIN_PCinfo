            "{EncodedCollectorPayload}"
          ],
          "deadlineMilliseconds": 5000,
          "standardOutputMaximumBytes": 8192,
          "standardErrorMaximumBytes": 4096,
          "cancellationGraceMilliseconds": 750,
          "terminationVerificationMilliseconds": 2000,
          "intendedScopeIds": ["scope:device.windows-readiness"],
          "subjectIds": ["subject:device:primary"]
        }
      ]
    },
    {
      "collectorId": "collector:windows.device-context",
      "collectorVersion": "1.0.0",
      "purpose": "Collect bounded Windows activation, device form, virtualization, chassis, battery, and power context without configuration changes or key material.",
      "executable": {
        "resolver": "ActivePowerShellHost",
        "fileName": "pwsh.exe",
        "signerCommonName": "Microsoft Corporation"
      },
      "payload": {
        "kind": "EncodedReleaseSource",
