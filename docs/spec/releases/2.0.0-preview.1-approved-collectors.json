        }
      ]
    }
  ],
  "validationFixtures": [
    { "fixtureId": "wrong-executable", "operationMode": "Success", "fault": "ExecutableIdentityMismatch" },
    { "fixtureId": "invalid-argument", "operationMode": "Success", "fault": "SecretShapedArgument" },
    { "fixtureId": "excess-output", "operationMode": "ExcessOutput", "fault": "OutputLimitExceeded" },
    { "fixtureId": "timeout", "operationMode": "Timeout", "fault": "DeadlineExceeded", "deadlineMilliseconds": 200 },
    { "fixtureId": "cooperative-cancel", "operationMode": "CooperativeCancel", "fault": "CancellationRequested" },
    { "fixtureId": "hard-cancel", "operationMode": "HardCancel", "fault": "CancellationGraceExceeded" },
    { "fixtureId": "child-process", "operationMode": "ChildProcess", "fault": "None" },
    { "fixtureId": "incompatible-child", "operationMode": "Success", "fault": "JobAssignmentIncompatible" }
  ]
