{
  "kind": "win-pcinfo.approved-collector-catalog",
  "contractVersion": "1.0.0",
  "release": "2.0.0-preview.1",
  "limits": {
    "maximumArgumentCount": 8,
    "maximumArgumentUtf8Bytes": 30000,
    "maximumEnvironmentVariables": 4,
    "maximumEnvironmentValueUtf8Bytes": 30000
  },
  "collectors": [
    {
      "collectorId": "collector:synthetic.windows.os",
      "collectorVersion": "1.0.0",
      "purpose": "Exercise the Process Supervisor with synthetic Unicode evidence without claiming device collection.",
      "executable": {
        "resolver": "ActivePowerShellHost",
        "fileName": "pwsh.exe",
        "signerCommonName": "Microsoft Corporation"
      },
      "payload": {
        "kind": "EncodedReleaseSource",
        "encoding": "PowerShellEncodedCommandUtf16Le",
        "sha256": "a0ec7bda1e13eb250fcae4eaa5fc112502e38c8e90b6d3d27492a121d266e359"
      },
      "workingBoundary": {
        "kind": "ActivePowerShellHome",
        "writesAllowed": false
      },
      "environment": {
        "inheritParent": false,
        "variables": [
          { "name": "SystemRoot", "valueSource": "WindowsDirectory" },
          { "name": "WINPCINFO_CANCEL_EVENT", "valueSource": "CancellationEventName" },
          { "name": "WINPCINFO_OPERATION_MODE", "valueSource": "OperationMode" },
          { "name": "WINPCINFO_ENCODED_PAYLOAD", "valueSource": "EncodedPayload" }
        ]
      },
      "treeControl": {
        "mode": "WindowsJobObjectRequired",
        "startSuspendedBeforeAssignment": true,
        "killOnClose": true,
        "incompatibleDisposition": "NotStarted"
      },
      "operations": [
        {
          "operationId": "op:synthetic.windows.os.success",
          "arguments": [
            "-NoLogo",
            "-NoProfile",
            "-NonInteractive",
            "-EncodedCommand",
            "{EncodedCollectorPayload}"
          ],
          "deadlineMilliseconds": 5000,
          "standardOutputMaximumBytes": 4096,
          "standardErrorMaximumBytes": 4096,
          "cancellationGraceMilliseconds": 750,
          "terminationVerificationMilliseconds": 2000,
          "intendedScopeIds": ["scope:synthetic.device.os"],
          "subjectIds": ["subject:device:primary"]
        }
      ]
    },
    {
      "collectorId": "collector:windows.device-readiness",
      "collectorVersion": "1.0.0",
