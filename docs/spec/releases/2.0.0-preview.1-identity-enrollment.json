{
  "kind": "win-pcinfo.identity-enrollment-policy",
  "contractVersion": "1.0.0",
  "release": "2.0.0-preview.1",
  "policyId": "win-pcinfo.identity-enrollment/1.0.0",
  "evidenceProfileId": "profile:device-firmware-and-identity-readiness",
  "collectors": [
    {
      "collectorId": "collector:windows.registration-and-user-context",
      "collectorVersion": "1.0.0",
      "operationId": "observe-device-registration",
      "source": "Release-embedded native Windows API projection for domain join, Entra registration, and the SID-bound interactive Assessment User Context",
      "executionContext": "StandardUser",
      "privilege": "NoElevation",
      "networkBehavior": "OfflineOnly",
      "executable": "ActiveMicrosoftSignedPowerShellHost",
      "dependencies": [
        "Windows NetGetJoinInformation API",
        "Windows NetGetAadJoinInformation API",
        "Windows Terminal Services session APIs",
        "Windows LSA logon session APIs"
      ],
      "mayPrompt": false,
      "mayInstall": false,
      "mayDownload": false,
      "maySelfElevate": false,
      "writesAllowed": false,
      "maximumAttempts": 1,
      "deadlineMilliseconds": 5000,
      "resultMaximumUtf8Bytes": 8192,
      "cleanup": "CoordinatorOwnedJobObjectAndWorkerVerifiedAbsent"
    },
    {
      "collectorId": "collector:windows.work-school-context",
      "collectorVersion": "1.0.0",
      "operationId": "observe-enrollment-context",
      "source": "Release-embedded NetGetAadJoinInformation projection limited to the device-default local work-or-school registration",
      "executionContext": "StandardUser",
      "privilege": "NoElevation",
      "networkBehavior": "OfflineOnly",
      "executable": "ActiveMicrosoftSignedPowerShellHost",
      "dependencies": ["Windows NetGetAadJoinInformation API"],
      "mayPrompt": false,
      "mayInstall": false,
      "mayDownload": false,
      "maySelfElevate": false,
      "writesAllowed": false,
      "maximumAttempts": 1,
      "deadlineMilliseconds": 5000,
      "resultMaximumUtf8Bytes": 4096,
      "cleanup": "CoordinatorOwnedJobObjectAndWorkerVerifiedAbsent"
    },
    {
      "collectorId": "collector:windows.mdm-bridge.device-manageability",
      "collectorVersion": "1.0.0",
      "operationId": "observe-mdm-system-context",
      "source": "Predefined read-only MDM Bridge provider-presence operation from the SYSTEM Collection sub-plan",
      "executionContext": "LocalSystem",
      "privilege": "RequiresLocalSystem",
      "networkBehavior": "OfflineOnly",
      "executable": "ActiveMicrosoftSignedPowerShellHost",
      "dependencies": ["Windows MDM Bridge WMI provider", "Windows Task Scheduler COM API"],
      "mayPrompt": false,
      "mayInstall": false,
      "mayDownload": false,
      "maySelfElevate": false,
      "writesAllowed": false,
      "maximumAttempts": 1,
      "deadlineMilliseconds": 5000,
      "resultMaximumUtf8Bytes": 8192,
      "cleanup": "CoordinatorOwnedJobObjectTaskPipeAndWorkerVerifiedAbsent"
    }
  ],
  "scopes": [
    {
      "scopeId": "scope:identity.assessment-user-context",
      "fieldIds": [
        "field:identity.assessment-user.verified",
        "field:identity.assessment-user.session-id",
        "field:identity.assessment-user.account-name"
      ]
    },
    {
      "scopeId": "scope:device.registration-context",
      "fieldIds": [
        "field:device.domain-join.state",
        "field:device.domain-join.name",
        "field:device.entra-registration.type",
        "field:device.entra-registration.device-id",
        "field:device.entra-registration.tenant-id"
      ]
    },
    {
      "scopeId": "scope:device.work-school-registration-context",
      "fieldIds": [
        "field:device.work-school-registration.present",
        "field:device.work-school-registration.identifier"
      ]
    },
    {
      "scopeId": "scope:device.mdm-policy.system",
      "fieldIds": ["field:device.mdm-bridge.provider-available"]
    }
  ],
  "rules": [
    {
      "findingKind": "assessment-user-context",
      "ruleId": "rule:identity.assessment-user-context/1.0.0",
      "operationId": "op:rule.assessment-user-context.evaluate",
      "source": "ReleaseEmbeddedValidatedObservationRule",
      "executionContext": "SupervisedValidatedAssessmentRecord",
      "privilege": "NoElevation",
      "networkBehavior": "OfflineOnly",
      "executable": "ActiveMicrosoftSignedPowerShellHost",
      "dependencies": ["WIN-PCInfo Process Supervisor"],
      "mayPrompt": false, "mayInstall": false, "mayDownload": false,
      "maySelfElevate": false, "writesAllowed": false, "maximumAttempts": 1,
      "deadlineMilliseconds": 2000, "maximumInputObservations": 3,
      "maximumOutputFindings": 1, "cleanup": "CoordinatorOwnedJobObjectAndWorkerVerifiedAbsent",
      "missingEvidenceOutcome": "Indeterminate"
    },
    {
      "findingKind": "device-registration-context",
      "ruleId": "rule:identity.device-registration-context/1.0.0",
      "operationId": "op:rule.device-registration-context.evaluate",
      "source": "ReleaseEmbeddedValidatedObservationRule",
      "executionContext": "SupervisedValidatedAssessmentRecord",
      "privilege": "NoElevation",
      "networkBehavior": "OfflineOnly",
      "executable": "ActiveMicrosoftSignedPowerShellHost",
      "dependencies": ["WIN-PCInfo Process Supervisor"],
      "mayPrompt": false, "mayInstall": false, "mayDownload": false,
      "maySelfElevate": false, "writesAllowed": false, "maximumAttempts": 1,
      "deadlineMilliseconds": 2000, "maximumInputObservations": 5,
      "maximumOutputFindings": 1, "cleanup": "CoordinatorOwnedJobObjectAndWorkerVerifiedAbsent",
      "missingEvidenceOutcome": "Indeterminate"
    },
    {
      "findingKind": "work-school-enrollment-context",
      "ruleId": "rule:identity.work-school-enrollment-context/1.0.0",
      "operationId": "op:rule.work-school-enrollment-context.evaluate",
      "source": "ReleaseEmbeddedValidatedObservationRule",
      "executionContext": "SupervisedValidatedAssessmentRecord",
      "privilege": "NoElevation",
      "networkBehavior": "OfflineOnly",
      "executable": "ActiveMicrosoftSignedPowerShellHost",
      "dependencies": ["WIN-PCInfo Process Supervisor"],
      "mayPrompt": false, "mayInstall": false, "mayDownload": false,
      "maySelfElevate": false, "writesAllowed": false, "maximumAttempts": 1,
      "deadlineMilliseconds": 2000, "maximumInputObservations": 3,
      "maximumOutputFindings": 1, "cleanup": "CoordinatorOwnedJobObjectAndWorkerVerifiedAbsent",
      "missingEvidenceOutcome": "Indeterminate"
    }
  ],
  "discoveryTasks": [
    {
      "definitionId": "task:confirm-tenant-device-assignment/1.0.0",
      "purpose": "Confirm the device object and intended assignment in the authorized Microsoft Entra tenant.",
      "requiredRole": "MicrosoftEntraDeviceAdministratorOrReader",
      "approvedDestination": "AuthorizedMicrosoftEntraAdministrationBoundary",
      "expectedSafeResult": "An assigned, not assigned, or unavailable conclusion without exporting tenant or device identifiers."
    },
    {
      "definitionId": "task:confirm-tenant-compliance/1.0.0",
      "purpose": "Confirm the service-side compliance state that cannot be established from local registration evidence.",
      "requiredRole": "IntuneAdministratorOrReadOnlyOperator",
      "approvedDestination": "AuthorizedMicrosoftIntuneAdministrationBoundary",
      "expectedSafeResult": "A compliant, noncompliant, not evaluated, or unavailable service-side conclusion."
    },
    {
      "definitionId": "task:confirm-tenant-licensing/1.0.0",
      "purpose": "Confirm the user and service licensing required for the intended enrollment path.",
      "requiredRole": "Microsoft365LicenseAdministratorOrReader",
      "approvedDestination": "AuthorizedMicrosoft365AdministrationBoundary",
      "expectedSafeResult": "A sufficient, insufficient, or unavailable licensing conclusion without copying account identifiers."
    },
    {
      "definitionId": "task:confirm-organization-enrollment-intent/1.0.0",
      "purpose": "Confirm the organization's intended join and enrollment target for this device class.",
      "requiredRole": "EndpointManagementOwner",
      "approvedDestination": "AuthorizedOrganizationPlanningBoundary",
      "expectedSafeResult": "One approved target state or an explicit unresolved decision without changing the assessed device."
    },
    {
      "definitionId": "task:confirm-approved-administrator-context/1.0.0",
      "purpose": "Confirm intended administrator assignments with the device owner before planning enrollment or privilege changes. Direct local membership cannot establish organizational approval or nested group membership.",
      "requiredRole": "EndpointManagementOwnerOrAuthorizedDirectoryReader",
      "approvedDestination": "AuthorizedOrganizationIdentityAdministrationBoundary",
      "expectedSafeResult": "An approved, unexpected, or unresolved assignment conclusion, with nested-group discovery assigned separately. Do not remove accounts or copy principal identifiers into public evidence."
    },
    {
      "definitionId": "task:confirm-recovery-escrow/1.0.0",
      "purpose": "Confirm the organization's intended recovery escrow destination and whether recovery material is available there before an enrollment or identity migration. Local registration and encryption state cannot establish escrow.",
      "requiredRole": "AuthorizedRecoveryAdministrator",
      "approvedDestination": "OrganizationApprovedRecoveryAdministrationBoundary",
      "expectedSafeResult": "An available, unavailable, not applicable, or unresolved escrow conclusion for the assessed device. Use approved access without retrieving, displaying, exporting, or recording recovery secrets in this assessment."
    }
  ],
  "validationScenarios": [
    "Workgroup", "DomainJoined", "EntraJoined", "Registered", "Mixed", "Unenrolled",
    "UserContextUnavailable", "StandardUser", "Administrator", "LocalSystem",
    "NonEnglish", "Malformed", "Denied"
  ]
}
