    {
      "layerId": "AppliedPolicyEvidence",
      "purpose": "Locally cached RSoP identity, applicability, link, and precedence reported for the assessed device and Assessment User Context.",
      "scopeIds": [
        "scope:policy.applied.user.identity", "scope:policy.applied.user.applicability",
        "scope:policy.applied.user.link", "scope:policy.applied.user.precedence",
