{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmanuelng/WIN_PCinfo/schemas/azure-validation-round-outcome.schema.json",
  "title": "WIN-PCInfo sanitized Azure validation-round outcome",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType",
    "contractVersion",
    "state",
    "reasonCode",
    "admitted",
    "created",
    "guestReady",
    "candidateVerified",
    "payloadVerified",
    "localOnlyChecked",
    "approvedEgressChecked",
    "assessmentExecuted",
    "sanitizedRetrieval",
    "cleanupFirst",
    "teardownCompleted",
    "zeroResidue",
    "terraformStateRemoved",
    "nextRoundEligible",
    "persistentScopePreserved",
    "hostPeeringAbsent",
    "tagSweepEmpty",
    "unprotectedLocalMaterialAbsent",
    "guestControl",
    "bootstrapCredentialExposed",
    "clientCapturedOrReused",
    "vmPublicIpAssigned",
    "freshApprovedBaseline",
    "clientCount",
    "windows11ClaimingRoute",
    "trustClass",
    "qualifyingEvidence",
    "sliceDeliversCapability",
    "collectionStarted",
    "synthetic",
    "platformKind",
    "azureContacted",
    "supportClaim",
    "previewOrStableClaim",
    "privacyBoundary",
    "cleanupMode",
    "cancelled",
    "cancelPhase",
    "expiryReached",
    "cleanupReserveActive",
    "hardExpiryMinutes",
    "cleanupReserveMinutes",
    "newTestsStopped",
    "evidenceExportStopped",
    "exclusiveLeaseHeld",
    "liveTaggedVmCount",
    "resultingTotalExceedsMaximum",
    "recoveryIndependent",
    "unresolvedTargetPreserved",
    "unrelatedTargetPreserved",
    "cleanupPending",
    "operationsRecordRetained",
    "completedRecordRetentionDays",
    "documentedIncident"
  ],
  "properties": {
    "recordType": { "const": "win-pcinfo.azure-validation-round" },
    "contractVersion": { "const": "1.0.0" },
    "state": {
      "enum": [
        "ZeroResidueProven",
        "FailedCleaned",
        "Rejected",
        "Blocked",
        "ResidueRemains"
      ]
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^VALIDATION\\.[A-Z0-9_]+$"
    },
    "admitted": { "type": "boolean" },
    "created": { "type": "boolean" },
    "guestReady": { "type": "boolean" },
    "candidateVerified": { "type": "boolean" },
    "payloadVerified": { "type": "boolean" },
    "localOnlyChecked": { "type": "boolean" },
    "approvedEgressChecked": { "type": "boolean" },
    "assessmentExecuted": { "type": "boolean" },
    "sanitizedRetrieval": { "type": "boolean" },
    "cleanupFirst": { "type": "boolean" },
    "teardownCompleted": { "type": "boolean" },
    "zeroResidue": { "type": "boolean" },
    "terraformStateRemoved": { "type": "boolean" },
    "nextRoundEligible": { "type": "boolean" },
    "persistentScopePreserved": { "type": "boolean" },
    "hostPeeringAbsent": { "type": "boolean" },
    "tagSweepEmpty": { "type": "boolean" },
    "unprotectedLocalMaterialAbsent": { "type": "boolean" },
    "guestControl": {
      "enum": ["VmAgentRunCommand", "None"]
    },
    "bootstrapCredentialExposed": { "type": "boolean" },
    "clientCapturedOrReused": { "type": "boolean" },
    "vmPublicIpAssigned": { "type": "boolean" },
    "freshApprovedBaseline": { "type": "boolean" },
    "clientCount": { "type": ["integer", "null"], "minimum": 0, "maximum": 8 },
    "windows11ClaimingRoute": { "type": "boolean" },
    "trustClass": {
      "enum": ["ControllerDevTracer", "None"]
    },
    "qualifyingEvidence": { "const": false },
    "sliceDeliversCapability": { "const": false },
    "collectionStarted": { "const": false },
    "synthetic": { "type": "boolean" },
    "platformKind": {
      "enum": ["Synthetic", "ManagedIdentity", "Unavailable"]
    },
    "azureContacted": { "type": "boolean" },
    "supportClaim": { "const": "None" },
    "previewOrStableClaim": { "const": "None" },
    "privacyBoundary": {
      "enum": ["PrivateExternalWorkspace", "Missing", "Rejected"]
    },
    "cleanupMode": {
      "enum": ["None", "RoundCleanupMode", "CleanupPending"]
    },
    "cancelled": { "type": "boolean" },
    "cancelPhase": {
      "enum": [
        "None",
        "Create",
        "Readiness",
        "Transfer",
        "Execution",
        "Retrieval",
        "Teardown"
      ]
    },
    "expiryReached": { "type": "boolean" },
    "cleanupReserveActive": { "type": "boolean" },
    "hardExpiryMinutes": { "const": 360 },
    "cleanupReserveMinutes": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 360
    },
    "newTestsStopped": { "type": "boolean" },
    "evidenceExportStopped": { "type": "boolean" },
    "exclusiveLeaseHeld": { "type": "boolean" },
    "liveTaggedVmCount": {
      "type": ["integer", "null"],
      "minimum": 0,
      "maximum": 8
    },
    "resultingTotalExceedsMaximum": { "type": "boolean" },
    "recoveryIndependent": { "type": "boolean" },
    "unresolvedTargetPreserved": { "type": "boolean" },
    "unrelatedTargetPreserved": { "type": "boolean" },
    "cleanupPending": { "type": "boolean" },
    "operationsRecordRetained": { "type": "boolean" },
    "completedRecordRetentionDays": { "const": 7 },
    "documentedIncident": { "type": "boolean" }
  }
}
