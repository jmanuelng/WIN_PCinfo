{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmanuelng/WIN_PCinfo/schemas/protected-package-envelope.schema.json",
  "title": "WIN-PCInfo Protected Package envelope header",
  "type": "object",
  "additionalProperties": false,
  "required": ["formatVersion", "algorithm", "keyProtection", "recipientKeyProtection", "chunkPlaintextBytes", "plaintextLength", "chunkCount", "noncePrefix", "protectedContentKey", "recipientWrappedContentKey"],
  "properties": {
    "formatVersion": { "const": 1 },
    "algorithm": { "const": "AES-256-GCM" },
    "keyProtection": { "const": "DPAPI-CurrentUser" },
    "recipientKeyProtection": { "enum": ["None", "RSA-OAEP-SHA-256"] },
    "chunkPlaintextBytes": { "const": 16384 },
    "plaintextLength": { "type": "integer", "minimum": 1, "maximum": 2621440 },
    "chunkCount": { "type": "integer", "minimum": 1, "maximum": 160 },
    "noncePrefix": { "type": "string", "pattern": "^[A-Za-z0-9+/]{11}=$" },
    "protectedContentKey": { "type": "string", "minLength": 44, "maxLength": 5464, "pattern": "^[A-Za-z0-9+/]+={0,2}$" },
    "recipientWrappedContentKey": {
      "type": ["string", "null"],
      "minLength": 344,
      "maxLength": 2732,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    }
  },
  "allOf": [
    {
      "if": { "properties": { "recipientKeyProtection": { "const": "None" } } },
      "then": { "properties": { "recipientWrappedContentKey": { "type": "null" } } },
      "else": { "properties": { "recipientWrappedContentKey": { "type": "string" } } }
    }
  ]
}
