    "source":{"type":"object","additionalProperties":false,"required":["sourceId","interface","approvedProperties","limitation"],"properties":{"sourceId":{"pattern":"^source:windows\\."},"interface":{"type":"string","minLength":5,"maxLength":128},"approvedProperties":{"type":"array","minItems":2,"maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":64}},"limitation":{"type":"string","minLength":20,"maxLength":128}}},
