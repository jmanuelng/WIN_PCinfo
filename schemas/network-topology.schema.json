    "collector":{"type":"object","additionalProperties":false,"required":["collectorId","collectorVersion","operationId","source","executionContext","privilege","networkBehavior","executable","dependencies","mayPrompt","mayInstall","mayDownload","maySelfElevate","writesAllowed","maximumAttempts","deadlineMilliseconds","resultSerialization","resultMaximumUtf8Bytes","resultBoundDerivation","maximumItemsPerScope","cleanup"],"properties":{"collectorId":{"const":"collector:windows.local-network-topology"},"collectorVersion":{"const":"1.0.0"},"operationId":{"const":"observe-network-context"},"source":{"type":"string","minLength":40,"maxLength":512},"executionContext":{"const":"StandardUser"},"privilege":{"const":"NoElevation"},"networkBehavior":{"const":"OfflineOnly"},"executable":{"const":"ActiveMicrosoftSignedPowerShellHost"},"dependencies":{"const":["System.Net.NetworkInformation","iphlpapi.dll","Network List Manager COM","Microsoft.Win32.Registry","Current User RAS phonebook"]},"mayPrompt":{"const":false},"mayInstall":{"const":false},"mayDownload":{"const":false},"maySelfElevate":{"const":false},"writesAllowed":{"const":false},"maximumAttempts":{"const":1},"deadlineMilliseconds":{"const":30000},"resultSerialization":{"const":"Utf8Json"},"resultMaximumUtf8Bytes":{"const":262144},"resultBoundDerivation":{"const":{"maximumAdmittedPayloadUtf8Bytes":160196,"fixtureShape":"EveryClosedCollectionAtEightItemsEveryFreeTextAtItsMaximumUtf8LengthControlCharactersAtSixByteJsonEscapeExpansion","serialization":"ConvertToJsonCompressDepth10Utf8NoBom","computedWorstCaseUtf8Bytes":160196,"ceilingRounding":"NextPowerOfTwo"}},"maximumItemsPerScope":{"const":8},"cleanup":{"const":"CoordinatorOwnedJobObjectAndWorkerVerifiedAbsent"}}},
