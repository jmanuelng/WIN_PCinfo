    "recommendation":{"type":"object","additionalProperties":false,"required":["definitionId","findingKind","purpose","responsibleRole","verification","caution"],"properties":{"definitionId":{"$ref":"#/$defs/id"},"findingKind":{"enum":["local-network-configuration","network-component-inventory","local-only-network-coverage"]},"purpose":{"type":"string","minLength":20,"maxLength":256},"responsibleRole":{"enum":["NetworkEngineer","SecurityEngineer","AssessmentOperator"]},"verification":{"type":"string","minLength":20,"maxLength":256},"caution":{"type":"string","minLength":20,"maxLength":256}}}
