{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jmanuelng/WIN_PCinfo/schemas/assessment-run-request.schema.json",
  "title": "WIN-PCInfo Assessment Run Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "profile",
    "outputDestination",
    "networkBehavior",
    "updateChoice",
    "diagnosticLevel",
    "automationChoices"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "profile": { "const": "ComprehensiveLocalAssessment" },
    "outputDestination": { "type": "string", "minLength": 1, "not": { "pattern": "^(\\\\|//)" } },
    "networkBehavior": {
      "enum": ["LocalOnly", "MicrosoftConnectivityEnabled"]
    },
    "updateChoice": { "const": "NoUpdateCheck" },
    "diagnosticLevel": { "const": "Standard" },
    "recipientSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "profilePath", "fingerprintConfirmation"],
      "properties": {
        "mode": { "enum": ["None", "Profile"] },
        "profilePath": { "type": ["string", "null"], "minLength": 1 },
        "fingerprintConfirmation": {
          "type": ["string", "null"],
          "pattern": "^(?:[0-9A-Fa-f]{64}|(?:[0-9A-Fa-f]{2}:){31}[0-9A-Fa-f]{2})$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "None" } } },
          "then": {
            "properties": {
              "profilePath": { "type": "null" },
              "fingerprintConfirmation": { "type": "null" }
            }
          },
          "else": {
            "properties": {
              "profilePath": { "type": "string" },
              "fingerprintConfirmation": { "type": "string" }
            }
          }
        }
      ]
    },
    "automationChoices": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowAssessmentNetwork",
        "allowElevation",
        "allowInstallation",
        "allowPersistentChanges",
        "allowStaleRecovery",
        "verificationOverride"
      ],
      "properties": {
        "allowAssessmentNetwork": { "type": "boolean" },
        "allowElevation": { "const": true },
        "allowInstallation": { "const": false },
        "allowPersistentChanges": { "const": false },
        "allowStaleRecovery": { "type": "boolean" },
        "verificationOverride": { "const": "None" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "networkBehavior": { "const": "LocalOnly" } } },
      "then": {
        "properties": {
          "automationChoices": {
            "properties": { "allowAssessmentNetwork": { "const": false } }
          }
        }
      },
      "else": {
        "properties": {
          "automationChoices": {
            "properties": { "allowAssessmentNetwork": { "const": true } }
          }
        }
      }
    }
  ]
}
