{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmanuelng/WIN_PCinfo/schemas/system-collection-plan.schema.json",
  "title": "WIN-PCInfo SYSTEM Collection sub-plan policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "release", "policyId", "operations", "activation", "channel", "treeControl", "deadlines", "security", "validationScenarios"],
  "properties": {
    "kind": { "const": "win-pcinfo.system-collection-plan-policy" },
    "contractVersion": { "const": "1.0.0" },
    "release": { "const": "2.0.0-preview.1" },
    "policyId": { "const": "win-pcinfo.system-collection-plan/1.0.0" },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [{ "$ref": "#/$defs/operation" }],
      "items": false
    },
    "activation": { "$ref": "#/$defs/activation" },
    "channel": { "$ref": "#/$defs/channel" },
    "treeControl": { "$ref": "#/$defs/treeControl" },
    "deadlines": { "$ref": "#/$defs/deadlines" },
    "security": { "$ref": "#/$defs/security" },
    "validationScenarios": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "uniqueItems": true,
      "prefixItems": [
        { "const": "SyntheticSuccess" },
        { "const": "UnknownOperation" },
        { "const": "InvalidParameters" },
        { "const": "ActivationFailure" },
        { "const": "WorkerLost" },
        { "const": "Cancellation" },
        { "const": "Timeout" },
        { "const": "Denied" },
        { "const": "AbnormalCleanup" },
        { "const": "MalformedPolicyResultArray" },
        { "const": "UnknownPolicyResultCatalog" },
        { "const": "AmbiguousPolicyResultInstances" },
        { "const": "MalformedPolicyResultValue" },
        { "const": "UnsupportedFutureBuild" },
        { "const": "ProviderQueryFailure" },
        { "const": "ProviderObservedAbsent" },
        { "const": "EmptyPolicyResultInstances" },
        { "const": "PolicyResultQueryFailure" },
        { "const": "PolicyResultClassUnsupported" },
        { "const": "ContradictoryPolicyResult" }
      ],
      "items": false
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "collectorId", "collectorVersion", "requiredExecutionContext", "administratorSufficient", "privilege", "networkBehavior", "executable", "dependencies", "maximumAttempts", "deadlineMilliseconds", "maximumResultUtf8Bytes", "cleanup", "source", "supplementalSources", "authorityProof", "parameters", "appLockerCspCatalog", "policyResultCatalogs", "intendedScopeIds", "privateResultScopeIds", "subjectIds", "result"],
      "properties": {
        "operationId": { "const": "op:windows.mdm-bridge.device-manageability" },
        "collectorId": { "const": "collector:windows.mdm-bridge.device-manageability" },
        "collectorVersion": { "const": "1.0.0" },
        "requiredExecutionContext": { "const": "LocalSystem" },
        "administratorSufficient": { "const": false },
        "privilege": { "const": "LocalSystemOnly" },
        "networkBehavior": { "const": "OfflineOnly" },
        "executable": { "const": "ActiveMicrosoftSignedPowerShellHost" },
        "dependencies": {
          "type": "array",
          "prefixItems": [
            { "const": "Microsoft.Win32.Registry" },
            { "const": "Microsoft.Management.Infrastructure" },
            { "const": "WindowsTaskSchedulerCom" },
            { "const": "WindowsNamedPipe" },
            { "const": "WindowsJobObject" }
          ],
          "items": false
        },
        "maximumAttempts": { "const": 1 },
        "deadlineMilliseconds": { "const": 5000 },
        "maximumResultUtf8Bytes": { "const": 8192 },
        "cleanup": { "const": "CoordinatorOwnedJobObjectTaskAndPipeVerifiedAbsent" },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceId", "interface", "namespace", "className", "access"],
          "properties": {
            "sourceId": { "const": "source:windows.mdm-bridge.device-manageability" },
            "interface": { "const": "WindowsMdmBridgeWmiProvider" },
            "namespace": { "const": "Root\\cimv2\\mdm\\dmmap" },
            "className": { "const": "MDM_DeviceManageability_Provider01_01" },
            "access": { "const": "ReadOnlyPresence" }
          }
        },
        "supplementalSources": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "prefixItems": [
            { "$ref": "#/$defs/buildNumberSource" },
            { "$ref": "#/$defs/controlPolicyResultSource" },
            { "$ref": "#/$defs/securityOptionsResultSource" },
            { "$ref": "#/$defs/updateResultSource" }
          ],
          "items": false
        },
        "authorityProof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url", "requirement"],
          "properties": {
            "kind": { "const": "MicrosoftDocumentation" },
            "url": { "const": "https://learn.microsoft.com/en-us/windows/client-management/using-powershell-scripting-with-the-wmi-bridge-provider" },
            "requirement": { "const": "DeviceSettingsRequireLocalSystem" }
          }
        },
        "parameters": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "required", "additionalProperties", "queryKind"],
          "properties": {
            "type": { "const": "object" },
            "required": { "type": "array", "prefixItems": [{ "const": "queryKind" }], "items": false },
            "additionalProperties": { "const": false },
            "queryKind": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "const", "maximumUtf8Bytes"],
              "properties": {
                "type": { "const": "string" },
                "const": { "const": "PolicyCspResultCatalogV1" },
                "maximumUtf8Bytes": { "const": 64 }
              }
            }
          }
        },
        "appLockerCspCatalog": { "const": {"scopeId":"scope:policy.applocker.csp-channel","sourceId":"source:windows.applocker.csp-policy","requiredExecutionContext":"LocalSystem","namespace":"Root\\cimv2\\mdm\\dmmap","properties":["EnforcementMode"],"maximumInstancesPerClass":8,"maximumCollections":5,"classes":["MDM_AppLocker_ApplicationLaunchRestrictions01_EXE03","MDM_AppLocker_DLL03","MDM_AppLocker_MSI03","MDM_AppLocker_Script03","MDM_AppLocker_ApplicationLaunchRestrictions01_StoreApps03"],"limitation":"MetadataOnlyMissingModeIsUnavailableNoPolicyXmlNoCrossGroupingWinnerNoGpInference"} },
        "policyResultCatalogs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/policyResultCatalog" }
        },
        "intendedScopeIds": { "type": "array", "prefixItems": [{ "const": "scope:device.mdm-policy.system" }], "items": false },
        "privateResultScopeIds": {
          "type": "array",
          "prefixItems": [
            { "const": "scope:policy.mdm.control-policy-conflict" },
            { "const": "scope:policy.mdm.security-option.machine-inactivity-limit" },
            { "const": "scope:policy.mdm.security-option.disable-cad" },
            { "const": "scope:policy.mdm.security-option.lm-compatibility-level" },
            { "const": "scope:policy.mdm.update.defer-feature-updates" },
            { "const": "scope:policy.mdm.update.defer-quality-updates" },
            { "const": "scope:policy.mdm.update.disable-dual-scan" },
            { "const": "scope:policy.applocker.csp-channel" }
          ],
          "items": false
        },
        "subjectIds": { "type": "array", "prefixItems": [{ "const": "subject:device:primary" }], "items": false },
        "result": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fieldId", "valueType", "maximumObservations"],
          "properties": {
            "fieldId": { "const": "field:device.mdm-bridge.provider-available" },
            "valueType": { "const": "Boolean" },
            "maximumObservations": { "const": 1 }
          }
        }
      }
    },
    "policyResultCatalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalogId", "minimumBuildNumber", "maximumBuildNumber", "resultFields"],
      "properties": {
        "catalogId": { "type": "string", "pattern": "^catalog:policy-csp-result\\.windows(?:10|11)/1\\.0\\.0$" },
        "minimumBuildNumber": { "type": "integer", "minimum": 10240, "maximum": 99999 },
        "maximumBuildNumber": { "type": "integer", "minimum": 10240, "maximum": 99999 },
        "resultFields": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": { "$ref": "#/$defs/policyResultField" }
        }
      }
    },
    "policyResultField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fieldId", "scopeId", "className", "parentId", "instanceId", "propertyName", "valueType", "minimumValue", "maximumValue"],
      "properties": {
        "fieldId": { "type": "string", "pattern": "^field:policy\\.mdm\\." },
        "scopeId": { "type": "string", "pattern": "^scope:policy\\.mdm\\." },
        "className": {
          "enum": [
            "MDM_Policy_Result01_ControlPolicyConflict02",
            "MDM_Policy_Result01_LocalPoliciesSecurityOptions02",
            "MDM_Policy_Result01_Update02"
          ]
        },
        "parentId": { "const": "./Vendor/MSFT/Policy/Result" },
        "instanceId": { "enum": ["ControlPolicyConflict", "LocalPoliciesSecurityOptions", "Update"] },
        "propertyName": {
          "enum": [
            "MDMWinsOverGP",
            "InteractiveLogon_MachineInactivityLimit",
            "Interactivelogon_DoNotRequireCTRLALTDEL",
            "NetworkSecurity_LANManagerAuthenticationLevel",
            "DeferFeatureUpdatesPeriodInDays",
            "DeferQualityUpdatesPeriodInDays",
            "DisableDualScan"
          ]
        },
        "valueType": { "enum": ["Boolean", "Integer"] },
        "minimumValue": { "type": "integer", "minimum": 0, "maximum": 599940 },
        "maximumValue": { "type": "integer", "minimum": 1, "maximum": 599940 }
      }
    },
    "buildNumberSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "interface", "hive", "keyPath", "valueName", "access"],
      "properties": {
        "sourceId": { "const": "source:windows.registry.current-build-number" },
        "interface": { "const": "WindowsRegistry" },
        "hive": { "const": "HKEY_LOCAL_MACHINE" },
        "keyPath": { "const": "SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion" },
        "valueName": { "const": "CurrentBuildNumber" },
        "access": { "const": "ReadOnlyValue" }
      }
    },
    "controlPolicyResultSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "interface", "namespace", "className", "parentId", "instanceId", "maximumInstances", "access"],
      "properties": {
        "sourceId": { "const": "source:windows.mdm-policy-result.control-policy-conflict" },
        "interface": { "const": "WindowsMdmBridgeWmiProvider" },
        "namespace": { "const": "Root\\cimv2\\mdm\\dmmap" },
        "className": { "const": "MDM_Policy_Result01_ControlPolicyConflict02" },
        "parentId": { "const": "./Vendor/MSFT/Policy/Result" },
        "instanceId": { "const": "ControlPolicyConflict" },
        "maximumInstances": { "const": 1 },
        "access": { "const": "ReadOnlyProperties" }
      }
    },
    "securityOptionsResultSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "interface", "namespace", "className", "parentId", "instanceId", "maximumInstances", "access"],
      "properties": {
        "sourceId": { "const": "source:windows.mdm-policy-result.local-policies-security-options" },
        "interface": { "const": "WindowsMdmBridgeWmiProvider" },
        "namespace": { "const": "Root\\cimv2\\mdm\\dmmap" },
        "className": { "const": "MDM_Policy_Result01_LocalPoliciesSecurityOptions02" },
        "parentId": { "const": "./Vendor/MSFT/Policy/Result" },
        "instanceId": { "const": "LocalPoliciesSecurityOptions" },
        "maximumInstances": { "const": 1 },
        "access": { "const": "ReadOnlyProperties" }
      }
    },
    "updateResultSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "interface", "namespace", "className", "parentId", "instanceId", "maximumInstances", "access"],
      "properties": {
        "sourceId": { "const": "source:windows.mdm-policy-result.update" },
        "interface": { "const": "WindowsMdmBridgeWmiProvider" },
        "namespace": { "const": "Root\\cimv2\\mdm\\dmmap" },
        "className": { "const": "MDM_Policy_Result01_Update02" },
        "parentId": { "const": "./Vendor/MSFT/Policy/Result" },
        "instanceId": { "const": "Update" },
        "maximumInstances": { "const": 1 },
        "access": { "const": "ReadOnlyProperties" }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "taskNamePrefix", "createDisposition", "principal", "logonType", "runLevel", "deleteAfterTerminal", "executableResolver", "executableFileName", "signerCommonName", "payloadKind", "payloadSha256"],
      "properties": {
        "kind": { "const": "TransientTaskSchedulerCom" },
        "taskNamePrefix": { "const": "WINPCInfo-SystemCollection-v1-" },
        "createDisposition": { "const": "CreateNewOnly" },
        "principal": { "const": "LocalSystem" },
        "logonType": { "const": "ServiceAccount" },
        "runLevel": { "const": "Highest" },
        "deleteAfterTerminal": { "const": true },
        "executableResolver": { "const": "ActivePowerShellHost" },
        "executableFileName": { "const": "pwsh.exe" },
        "signerCommonName": { "const": "Microsoft Corporation" },
        "payloadKind": { "const": "EncodedReleaseSource" },
        "payloadSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pipeNamePrefix", "jobNamePrefix", "maximumServerInstances", "maximumMessageUtf8Bytes", "nonceBytes", "acl", "requirePeerProcessId", "requireLocalSystemSid", "requireArtifactDigest", "assessmentEvidenceContract"],
      "properties": {
        "pipeNamePrefix": { "const": "WINPCInfo-SystemCollection-v1-" },
        "jobNamePrefix": { "const": "Global\\WINPCInfo-SystemCollection-v1-" },
        "maximumServerInstances": { "const": 1 },
        "maximumMessageUtf8Bytes": { "type": "integer", "minimum": 256, "maximum": 16384 },
        "nonceBytes": { "type": "integer", "minimum": 32, "maximum": 64 },
        "acl": { "const": "InitiatingUserAndLocalSystem" },
        "requirePeerProcessId": { "const": true },
        "requireLocalSystemSid": { "const": true },
        "requireArtifactDigest": { "const": true },
        "assessmentEvidenceContract": { "const": "PolicyCspResultCatalogV1" }
      }
    },
    "treeControl": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "workerJoinsBeforePlan", "killOnClose", "unownedExecutionAllowed"],
      "properties": {
        "mode": { "const": "WindowsJobObjectRequired" },
        "workerJoinsBeforePlan": { "const": true },
        "killOnClose": { "const": true },
        "unownedExecutionAllowed": { "const": false }
      }
    },
    "deadlines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activationMaximumMilliseconds", "operationMaximumMilliseconds", "cancellationGraceMilliseconds", "terminationVerificationMilliseconds", "cleanupMaximumMilliseconds"],
      "properties": {
        "activationMaximumMilliseconds": { "type": "integer", "minimum": 100, "maximum": 10000 },
        "operationMaximumMilliseconds": { "type": "integer", "minimum": 100, "maximum": 60000 },
        "cancellationGraceMilliseconds": { "type": "integer", "minimum": 100, "maximum": 2000 },
        "terminationVerificationMilliseconds": { "type": "integer", "minimum": 100, "maximum": 5000 },
        "cleanupMaximumMilliseconds": { "type": "integer", "minimum": 100, "maximum": 5000 }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentUserContextAllowed", "localPackageProtectorAllowed", "recipientProfileAllowed", "credentialMaterialAllowed", "packageKeyAllowed", "callerExecutablePathAllowed", "callerScriptAllowed", "callerCommandAllowed"],
      "properties": {
        "assessmentUserContextAllowed": { "const": false },
        "localPackageProtectorAllowed": { "const": false },
        "recipientProfileAllowed": { "const": false },
        "credentialMaterialAllowed": { "const": false },
        "packageKeyAllowed": { "const": false },
        "callerExecutablePathAllowed": { "const": false },
        "callerScriptAllowed": { "const": false },
        "callerCommandAllowed": { "const": false }
      }
    }
  }
}
