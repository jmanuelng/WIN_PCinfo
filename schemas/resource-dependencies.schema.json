{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/jmanuelng/WIN_PCinfo/schemas/resource-dependencies.schema.json",
  "title":"WIN-PCInfo resource dependency release policy",
  "type":"object","additionalProperties":false,
  "required":["kind","contractVersion","release","policyId","evidenceProfileId","layers","collector","sourceCatalog","peripheralClassCatalog","scopes","rules","recommendations","validationScenarios"],
  "properties":{
    "kind":{"const":"win-pcinfo.resource-dependencies-policy"},"contractVersion":{"const":"1.0.0"},"release":{"const":"2.0.0-preview.1"},"policyId":{"const":"win-pcinfo.resource-dependencies/1.0.0"},"evidenceProfileId":{"const":"profile:device-firmware-identity-administrator-policy-and-resource-dependencies"},
    "layers":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/layer"}},
    "collector":{"$ref":"#/$defs/collector"},
    "sourceCatalog":{"type":"array","minItems":5,"maxItems":5,"items":{"$ref":"#/$defs/source"}},
    "peripheralClassCatalog":{"const":["Bluetooth","HIDClass","Image","Keyboard","MEDIA","Mouse","Printer","USB"]},
    "scopes":{"type":"array","minItems":5,"maxItems":5,"items":{"$ref":"#/$defs/scope"}},
    "rules":{"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/rule"}},
    "recommendations":{"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/recommendation"}},
    "validationScenarios":{"const":["MappedDrive","DisconnectedDrive","UncResource","Printers","PortsAndDrivers","Peripherals","Empty","Denied","Partial","Duplicates","LongUnicode","AlternateAdministrator","LocalSystem","NonEnglish"]}
  },
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z][A-Za-z0-9._:/-]*$"},
    "layer":{"type":"object","additionalProperties":false,"required":["layerId","purpose","scopeIds"],"properties":{"layerId":{"enum":["UserResourceDependencies","PeripheralDependencies"]},"purpose":{"type":"string","minLength":20,"maxLength":256},"scopeIds":{"type":"array","minItems":2,"maxItems":3,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}},
    "collector":{"type":"object","additionalProperties":false,"required":["collectorId","collectorVersion","operationId","source","executionContext","privilege","networkBehavior","executable","dependencies","mayPrompt","mayInstall","mayDownload","maySelfElevate","writesAllowed","maximumAttempts","deadlineMilliseconds","resultMaximumUtf8Bytes","maximumMappedDrives","maximumUncConnections","maximumPrinters","maximumPrinterDrivers","maximumPeripherals","cleanup"],"properties":{"collectorId":{"const":"collector:windows.resource-dependencies"},"collectorVersion":{"const":"1.0.0"},"operationId":{"const":"observe-user-dependencies"},"source":{"type":"string","minLength":40,"maxLength":512},"executionContext":{"const":"StandardUser"},"privilege":{"const":"NoElevation"},"networkBehavior":{"const":"OfflineOnly"},"executable":{"const":"ActiveMicrosoftSignedPowerShellHost"},"dependencies":{"const":["Microsoft.Win32.Registry","Windows CIM provider"]},"mayPrompt":{"const":false},"mayInstall":{"const":false},"mayDownload":{"const":false},"maySelfElevate":{"const":false},"writesAllowed":{"const":false},"maximumAttempts":{"const":1},"deadlineMilliseconds":{"const":5000},"resultMaximumUtf8Bytes":{"const":32768},"maximumMappedDrives":{"const":8},"maximumUncConnections":{"const":8},"maximumPrinters":{"const":8},"maximumPrinterDrivers":{"const":8},"maximumPeripherals":{"const":8},"cleanup":{"const":"CoordinatorOwnedJobObjectAndWorkerVerifiedAbsent"}}},
    "source":{"type":"object","additionalProperties":false,"required":["sourceId","interface","approvedProperties","limitation"],"properties":{"sourceId":{"$ref":"#/$defs/id"},"interface":{"type":"string","minLength":5,"maxLength":128},"approvedProperties":{"type":"array","minItems":3,"maxItems":10,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":64}},"limitation":{"type":"string","minLength":20,"maxLength":128}}},
    "scope":{"type":"object","additionalProperties":false,"required":["scopeId","fieldIds"],"properties":{"scopeId":{"$ref":"#/$defs/id"},"fieldIds":{"type":"array","minItems":3,"maxItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}},
    "rule":{"type":"object","additionalProperties":false,"required":["findingKind","ruleId","operationId","source","executionContext","privilege","networkBehavior","executable","dependencies","mayPrompt","mayInstall","mayDownload","maySelfElevate","writesAllowed","maximumAttempts","deadlineMilliseconds","maximumInputObservations","maximumOutputFindings","cleanup","missingEvidenceOutcome"],"properties":{"findingKind":{"enum":["user-resource-migration-dependencies","peripheral-migration-dependencies","resource-dependency-coverage"]},"ruleId":{"$ref":"#/$defs/id"},"operationId":{"$ref":"#/$defs/id"},"source":{"const":"ReleaseEmbeddedValidatedObservationRule"},"executionContext":{"const":"InProcessValidatedAssessmentRecord"},"privilege":{"const":"NoElevation"},"networkBehavior":{"const":"OfflineOnly"},"executable":{"const":"NoneInProcess"},"dependencies":{"const":[]},"mayPrompt":{"const":false},"mayInstall":{"const":false},"mayDownload":{"const":false},"maySelfElevate":{"const":false},"writesAllowed":{"const":false},"maximumAttempts":{"const":1},"deadlineMilliseconds":{"const":100},"maximumInputObservations":{"type":"integer","minimum":1,"maximum":192},"maximumOutputFindings":{"const":1},"cleanup":{"const":"NoArtifacts"},"missingEvidenceOutcome":{"const":"Indeterminate"}}},
    "recommendation":{"type":"object","additionalProperties":false,"required":["definitionId","findingKind","purpose","responsibleRole","verification","caution"],"properties":{"definitionId":{"$ref":"#/$defs/id"},"findingKind":{"enum":["user-resource-migration-dependencies","peripheral-migration-dependencies"]},"purpose":{"type":"string","minLength":20,"maxLength":256},"responsibleRole":{"enum":["MigrationOperator","EndpointEngineer"]},"verification":{"type":"string","minLength":20,"maxLength":256},"caution":{"type":"string","minLength":20,"maxLength":256}}}
  }
}
