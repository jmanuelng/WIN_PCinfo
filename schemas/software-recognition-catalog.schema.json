{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmanuelng/WIN_PCinfo/schemas/software-recognition-catalog.schema.json",
  "title": "WIN-PCInfo release Software Recognition Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "catalogRevision", "release", "sourceRevision", "operation", "roles", "licenseReview", "families"],
  "properties": {
    "kind": { "const": "win-pcinfo.software-recognition-catalog" },
    "schemaVersion": { "const": 1 },
    "catalogRevision": { "type": "integer", "minimum": 1 },
    "release": { "const": "2.0.0-preview.1" },
    "sourceRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "operation": { "$ref": "#/$defs/operation" },
    "roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/role" }
    },
    "licenseReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewedOn", "reviewer", "reuseBasis", "thirdPartyAssetsIncluded", "unlicensedCatalogDataIncluded"],
      "properties": {
        "reviewedOn": { "type": "string", "format": "date" },
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 128 },
        "reuseBasis": { "type": "string", "minLength": 1, "maxLength": 512 },
        "thirdPartyAssetsIncluded": { "const": false },
        "unlicensedCatalogDataIncluded": { "const": false }
      }
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/family" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "role": {
      "enum": ["EndpointSecurity", "DeviceManagement", "VpnOrZeroTrustNetworkAccess", "DataLossPrevention", "Encryption", "RemoteSupport", "AuthenticationOrCredentialProvider", "Browser", "PatchOrUpdateAgent", "BackupOrRecoveryAgent", "OtherMigrationDependency"]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "executionContext", "privilege", "networkBehavior", "executableOrDependency", "deadlineMilliseconds", "maximumInputEntries", "maximumOutputAnnotations", "maximumEvidenceUtf8Bytes", "cleanup", "mayPrompt", "mayInstall", "mayDownload", "maySelfElevate", "mayWidenScope", "mayRequestAuthority", "writesAllowed"],
      "properties": {
        "operationId": { "const": "annotate-software-recognition" },
        "executionContext": { "const": "InProcessValidatedAssessmentRecord" },
        "privilege": { "const": "StandardUser" },
        "networkBehavior": { "const": "OfflineOnly" },
        "executableOrDependency": { "const": "GeneratedWIN-PCInfoPowerShell" },
        "deadlineMilliseconds": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "maximumInputEntries": { "type": "integer", "minimum": 1, "maximum": 128 },
        "maximumOutputAnnotations": { "type": "integer", "minimum": 1, "maximum": 128 },
        "maximumEvidenceUtf8Bytes": { "type": "integer", "minimum": 1024, "maximum": 262144 },
        "cleanup": { "const": "InMemoryOnly" },
        "mayPrompt": { "const": false },
        "mayInstall": { "const": false },
        "mayDownload": { "const": false },
        "maySelfElevate": { "const": false },
        "mayWidenScope": { "const": false },
        "mayRequestAuthority": { "const": false },
        "writesAllowed": { "const": false }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "owner", "url", "verifiedOn", "reviewer", "pinnedCommit", "manifestPath"],
      "properties": {
        "sourceType": { "enum": ["PrimaryPublisherDocumentation", "ControlledFreshInstallation", "PinnedWinGetManifest"] },
        "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://" },
        "verifiedOn": { "type": "string", "format": "date" },
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pinnedCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "manifestPath": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "addedInRelease", "reviewedInRelease", "reason", "replacementFamilyId"],
      "properties": {
        "state": { "enum": ["active", "superseded", "withdrawn"] },
        "addedInRelease": { "type": "string", "minLength": 1, "maxLength": 64 },
        "reviewedInRelease": { "type": "string", "minLength": 1, "maxLength": 64 },
        "reason": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 },
        "replacementFamilyId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }
      }
    },
    "exactMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matcherId", "type", "value"],
      "properties": {
        "matcherId": { "$ref": "#/$defs/id" },
        "type": { "enum": ["ExactPackageFamilyName", "ExactMsiProductCode", "ExactMsiUpgradeCode"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "compositeMatcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["matcherId", "type", "registrationContext", "registryView", "fields"],
      "properties": {
        "matcherId": { "$ref": "#/$defs/id" },
        "type": { "const": "CompositeRegistration" },
        "registrationContext": { "enum": ["Machine", "AssessmentUser"] },
        "registryView": { "enum": ["Registry32", "Registry64"] },
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 2,
          "properties": {
            "registrationId": { "type": "string", "minLength": 1, "maxLength": 512 },
            "displayName": { "type": "string", "minLength": 1, "maxLength": 512 },
            "publisher": { "type": "string", "minLength": 1, "maxLength": 512 },
            "version": { "type": "string", "minLength": 1, "maxLength": 256 },
            "packageType": { "enum": ["DesktopRegistration", "MsiRegistration"] }
          }
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": false,
      "required": ["familyId", "label", "roles", "lifecycle", "matchers", "sources"],
      "properties": {
        "familyId": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 128 },
        "roles": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "$ref": "#/$defs/role" } },
        "lifecycle": { "$ref": "#/$defs/lifecycle" },
        "matchers": { "type": "array", "maxItems": 16, "items": { "oneOf": [{ "$ref": "#/$defs/exactMatcher" }, { "$ref": "#/$defs/compositeMatcher" }] } },
        "sources": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/source" } }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "lifecycle": { "properties": { "state": { "const": "active" } } }
            }
          },
          "then": {
            "properties": {
              "matchers": { "minItems": 1 },
              "lifecycle": {
                "properties": {
                  "reason": { "type": "null" },
                  "replacementFamilyId": { "type": "null" }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "lifecycle": {
                "properties": { "state": { "enum": ["superseded", "withdrawn"] } }
              }
            }
          },
          "then": {
            "properties": {
              "matchers": { "maxItems": 0 },
              "lifecycle": { "properties": { "reason": { "type": "string" } } }
            }
          }
        }
      ]
    }
  }
}
