{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmanuelng/WIN_PCinfo/schemas/preview-publication-request.schema.json",
  "title": "WIN-PCInfo synthetic Preview publication request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "contractVersion",
    "synthetic",
    "scenario",
    "privacyBoundary",
    "trustPath",
    "signingUnavailability",
    "waiverRequested",
    "bindings",
    "qualificationPacket",
    "humanApproval",
    "publisher",
    "assets",
    "limitations"
  ],
  "properties": {
    "kind": { "const": "win-pcinfo.preview-publication-request" },
    "contractVersion": { "const": "1.0.0" },
    "synthetic": { "const": true },
    "scenario": {
      "enum": [
        "CompleteApprovedSigned",
        "CompleteApprovedAttested",
        "HumanApprovalMissing",
        "ApprovalMismatch",
        "QualificationDenied",
        "WrongCandidate",
        "PrivacyUnsafe",
        "SilentReplacement",
        "GithubAuthUnavailable",
        "ImmutableTagExists",
        "DownloadDigestMismatch"
      ]
    },
    "privacyBoundary": { "const": "PrivatePublicationWorkspace" },
    "trustPath": {
      "enum": ["AuthenticodeSigned", "AttestedPreview"]
    },
    "signingUnavailability": {
      "enum": [
        "None",
        "ArtifactSigningNotOperational",
        "VerifiedServiceIncident"
      ]
    },
    "waiverRequested": { "type": "boolean" },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generatedContentSha256",
        "generatedContentIdentityKind",
        "finalDistributableSha256",
        "finalDistributableIdentityKind",
        "derivedFromGeneratedContentSha256"
      ],
      "properties": {
        "generatedContentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "generatedContentIdentityKind": {
          "const": "win-pcinfo.unsigned-generated-content-identity"
        },
        "finalDistributableSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "finalDistributableIdentityKind": {
          "enum": [
            "win-pcinfo.unsigned-portable-package-identity",
            "win-pcinfo.authenticode-signed-package-identity"
          ]
        },
        "derivedFromGeneratedContentSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "qualificationPacket": {
      "type": "object",
      "required": [
        "recordType",
        "state",
        "decision",
        "reasonCode",
        "publicationAuthorized",
        "trustPath"
      ]
    },
    "humanApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "confirmationPhrase",
        "candidateDigest",
        "qualificationPacketDigest",
        "limitationsDigest",
        "trustPath",
        "publicAssetListDigest",
        "confirmedStatements"
      ],
      "properties": {
        "present": { "type": "boolean" },
        "confirmationPhrase": {
          "type": "string",
          "maxLength": 64
        },
        "candidateDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "qualificationPacketDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "limitationsDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "trustPath": {
          "enum": ["AuthenticodeSigned", "AttestedPreview", "None"]
        },
        "publicAssetListDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "confirmedStatements": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "enum": [
              "candidate-digest",
              "qualification-packet",
              "limitations",
              "signing-or-attestation-state",
              "complete-public-asset-list"
            ]
          }
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "channel",
        "githubAuthAvailable",
        "existingTag",
        "replaceRequested",
        "fault"
      ],
      "properties": {
        "channel": {
          "enum": ["Synthetic", "GitHub"]
        },
        "githubAuthAvailable": { "type": "boolean" },
        "existingTag": { "type": "boolean" },
        "replaceRequested": { "type": "boolean" },
        "fault": {
          "enum": ["None", "TamperDownload"]
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "fileName", "sha256", "role"],
        "properties": {
          "assetId": {
            "enum": [
              "portable-package",
              "checksums",
              "sbom",
              "provenance",
              "dependency-inventory",
              "beginner-documentation",
              "preview-capability-matrix",
              "limitations",
              "sanitized-release-evidence"
            ]
          },
          "fileName": {
            "type": "string",
            "minLength": 8,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9._-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "role": {
            "enum": [
              "final-distributable",
              "checksums",
              "sbom",
              "provenance",
              "dependency-inventory",
              "beginner-documentation",
              "capability-matrix",
              "limitations",
              "sanitized-evidence"
            ]
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "enum": [
          "preview-not-supported",
          "best-effort-maintenance-no-sla",
          "microsoft-lifecycle-separated",
          "known-limitations-apply",
          "attested-preview-not-trusted",
          "synthetic-cannot-create-preview-claim",
          "human-approval-required-before-github",
          "no-silent-replacement",
          "final-artifact-bytes-not-launched"
        ]
      }
    }
  }
}
