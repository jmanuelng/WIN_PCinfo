{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmanuelng/WIN_PCinfo/schemas/administrator-exposure.schema.json",
  "title": "WIN-PCInfo Administrator Exposure release policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "release", "policyId", "evidenceProfileId", "administratorsGroup", "membershipSemantics", "collectors", "scopes", "rules", "validationScenarios"],
  "properties": {
    "kind": { "const": "win-pcinfo.administrator-exposure-policy" },
    "contractVersion": { "const": "1.0.0" },
    "release": { "const": "2.0.0-preview.1" },
    "policyId": { "const": "win-pcinfo.administrator-exposure/1.0.0" },
    "evidenceProfileId": { "const": "profile:device-firmware-identity-and-administrator-readiness" },
    "administratorsGroup": {
      "const": { "identity": "BuiltinAdministratorsAlias", "selection": "LookupBuiltinSidThenNetLocalGroupGetMembersLevel0" }
    },
    "membershipSemantics": { "const": "DirectMembersOnly" },
    "collectors": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "prefixItems": [{ "$ref": "#/$defs/collector" }], "items": false
    },
    "scopes": {
      "const": [{
        "scopeId": "scope:device.local-administrators.direct-membership",
        "fieldIds": [
          "field:device.local-administrators.group-sid",
          "field:device.local-administrators.enumeration-complete",
          "field:device.local-administrators.direct-member-count",
          "field:principal.windows.sid",
          "field:principal.windows.account-name",
          "field:principal.windows.kind",
          "field:principal.windows.origin",
          "field:principal.local-administrator.direct-member"
        ]
      }]
    },
    "rules": {
      "const": [{
        "findingKind": "local-administrator-exposure",
        "ruleId": "rule:identity.local-administrator-exposure/1.0.0",
        "operationId": "op:rule.local-administrator-exposure.evaluate",
        "source": "ReleaseEmbeddedValidatedObservationRule",
        "executionContext": "InProcessValidatedAssessmentRecord",
        "privilege": "NoElevation",
        "networkBehavior": "OfflineOnly",
        "executable": "NoneInProcess",
        "dependencies": [],
        "mayPrompt": false,
        "mayInstall": false,
        "mayDownload": false,
        "maySelfElevate": false,
        "writesAllowed": false,
        "maximumAttempts": 1,
        "deadlineMilliseconds": 100,
        "maximumInputObservations": 16,
        "maximumOutputFindings": 1,
        "cleanup": "NoArtifacts",
        "missingEvidenceOutcome": "Indeterminate",
        "expectedAccountContext": "OrganizationDefinedNotLocallyProvable",
        "compromiseConclusionAllowed": false,
        "automaticRemovalAllowed": false
      }]
    },
    "validationScenarios": {
      "const": ["LocalPrincipal", "DomainPrincipal", "NestedGroup", "UnresolvedSid", "DuplicateMembership", "AlternateAdministrator", "Denied", "Partial", "NonEnglish", "ElevationDenied"]
    }
  },
  "$defs": {
    "collector": {
      "const": {
        "collectorId": "collector:windows.local-administrators.direct-members",
        "collectorVersion": "1.0.0",
        "operationId": "observe-local-administrators",
        "source": "Release-embedded NetLocalGroupGetMembers level-0 SID projection selected through the built-in Administrators SID",
        "executionContext": "Administrator",
        "privilege": "RequiresAdministrator",
        "networkBehavior": "OfflineOnly",
        "executable": "ActiveMicrosoftSignedPowerShellHost",
        "dependencies": ["Windows NetLocalGroupGetMembers API", "Windows SID APIs"],
        "mayPrompt": false,
        "mayInstall": false,
        "mayDownload": false,
        "maySelfElevate": false,
        "writesAllowed": false,
        "maximumAttempts": 1,
        "deadlineMilliseconds": 5000,
        "resultMaximumUtf8Bytes": 16384,
        "maximumDirectMembers": 8,
        "cleanup": "CoordinatorOwnedJobObjectAndWorkerVerifiedAbsent"
      }
    }
  }
}
