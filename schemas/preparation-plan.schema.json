{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/jmanuelng/WIN_PCinfo/schemas/preparation-plan.schema.json",
  "title": "WIN-PCInfo Immutable Preparation Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType",
    "contractVersion",
    "release",
    "requestDigest",
    "scope",
    "operations",
    "deviceReadiness",
    "privilege",
    "dependencies",
    "estimates",
    "network",
    "output",
    "windowsFeatures",
    "limitations",
    "sideEffects",
    "cleanup",
    "governingResources",
    "integrity"
  ],
  "properties": {
    "recordType": { "const": "win-pcinfo.preparation-plan" },
    "contractVersion": { "const": "1.0.0" },
    "release": { "type": "string", "minLength": 1 },
    "requestDigest": { "$ref": "#/definitions/digest" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profileId", "profileName", "capabilities"],
      "properties": {
        "profileId": { "const": "comprehensive-local-assessment" },
        "profileName": { "const": "Comprehensive Local Assessment" },
        "capabilities": {
          "type": "array",
          "minItems": 29,
          "maxItems": 29,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "disposition", "dependsOnCapabilityIds"],
            "properties": {
              "id": { "pattern": "^CAP-[0-9]{4}$" },
              "name": { "type": "string", "minLength": 1 },
              "disposition": { "enum": ["Selected", "DependencyAdded", "ReleaseEnabledProductCapability"] },
              "dependsOnCapabilityIds": {
                "type": "array",
                "items": { "pattern": "^CAP-[0-9]{4}$" },
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 29,
      "maxItems": 29,
      "items": { "$ref": "#/definitions/operation" }
    },
    "deviceReadiness": {
      "const": {
        "kind": "win-pcinfo.device-readiness-policy",
        "contractVersion": "1.0.0",
        "release": "2.0.0-preview.1",
        "policyId": "win-pcinfo.device-windows-context/1.0.0",
        "scopeId": "scope:device.windows-context",
        "collector": {
          "collectorId": "collector:windows.device-context",
          "collectorVersion": "1.0.0",
          "operationId": "op:device.windows-context.collect",
          "source": "Release-embedded PowerShell using explicit Win32_ComputerSystem, Win32_Processor, Win32_OperatingSystem, SoftwareLicensingProduct, Win32_SystemEnclosure, and Win32_Battery property projections plus RuntimeInformation.OSArchitecture",
          "executionContext": "StandardUser",
          "privilege": "NoElevation",
          "networkBehavior": "OfflineOnly",
          "executable": "ActiveMicrosoftSignedPowerShellHost",
          "dependencies": ["Windows CIM provider", ".NET RuntimeInformation"],
          "mayPrompt": false, "mayInstall": false, "mayDownload": false,
          "maySelfElevate": false, "writesAllowed": false,
          "maximumAttempts": 1, "deadlineMilliseconds": 5000,
          "standardOutputMaximumBytes": 16384, "standardErrorMaximumBytes": 4096,
          "cleanup": "WindowsJobObjectAndNamedCancellationEventVerifiedAbsent"
        },
        "derivations": [
          {
            "derivedKind": "virtualization",
            "collectorId": "collector:win-pcinfo.device-context-classifier",
            "collectorVersion": "1.0.0", "operationId": "op:device.virtualization.classify",
            "sourceId": "source:win-pcinfo.virtualization-rule",
            "authoritativeIdentity": "win-pcinfo.virtualization-classifier/1.0.0",
            "executionContext": "InProcessValidatedAssessmentRecord", "privilege": "NoElevation",
            "networkBehavior": "OfflineOnly", "executable": "NoneInProcess", "dependencies": [],
            "mayPrompt": false, "mayInstall": false, "mayDownload": false,
            "maySelfElevate": false, "writesAllowed": false, "maximumAttempts": 1,
            "deadlineMilliseconds": 100, "maximumInputObservations": 2,
            "maximumOutputObservations": 1, "cleanup": "NoArtifacts"
          },
          {
            "derivedKind": "form-factor",
            "collectorId": "collector:win-pcinfo.device-context-classifier",
            "collectorVersion": "1.0.0", "operationId": "op:device.form-factor.classify",
            "sourceId": "source:win-pcinfo.form-factor-rule",
            "authoritativeIdentity": "win-pcinfo.form-factor-classifier/1.0.0",
            "executionContext": "InProcessValidatedAssessmentRecord", "privilege": "NoElevation",
            "networkBehavior": "OfflineOnly", "executable": "NoneInProcess", "dependencies": [],
            "mayPrompt": false, "mayInstall": false, "mayDownload": false,
            "maySelfElevate": false, "writesAllowed": false, "maximumAttempts": 1,
            "deadlineMilliseconds": 100, "maximumInputObservations": 3,
            "maximumOutputObservations": 1, "cleanup": "NoArtifacts"
          }
        ],
        "rules": [
          {
            "findingKind": "device-readiness", "ruleId": "rule:device.readiness/1.0.0",
            "operationId": "op:rule.device-readiness.evaluate",
            "source": "ReleaseEmbeddedValidatedObservationRule",
            "executionContext": "InProcessValidatedAssessmentRecord", "privilege": "NoElevation",
            "networkBehavior": "OfflineOnly", "executable": "NoneInProcess", "dependencies": [],
            "mayPrompt": false, "mayInstall": false, "mayDownload": false,
            "maySelfElevate": false, "writesAllowed": false, "maximumAttempts": 1,
            "deadlineMilliseconds": 100, "maximumInputObservations": 3,
            "maximumOutputFindings": 1, "cleanup": "NoArtifacts",
            "minimumMemoryBytes": 8589934592, "minimumWindowsBuild": 19045,
            "supportedArchitectures": ["X64", "Arm64"], "missingEvidenceOutcome": "Indeterminate"
          },
          {
            "findingKind": "activation-context", "ruleId": "rule:windows.activation-context/1.0.0",
            "operationId": "op:rule.windows-activation-context.evaluate",
            "source": "ReleaseEmbeddedValidatedObservationRule",
            "executionContext": "InProcessValidatedAssessmentRecord", "privilege": "NoElevation",
            "networkBehavior": "OfflineOnly", "executable": "NoneInProcess", "dependencies": [],
            "mayPrompt": false, "mayInstall": false, "mayDownload": false,
            "maySelfElevate": false, "writesAllowed": false, "maximumAttempts": 1,
            "deadlineMilliseconds": 100, "maximumInputObservations": 1,
            "maximumOutputFindings": 1, "cleanup": "NoArtifacts",
            "missingEvidenceOutcome": "Indeterminate"
          },
          {
            "findingKind": "platform-context", "ruleId": "rule:device.platform-context/1.0.0",
            "operationId": "op:rule.device-platform-context.evaluate",
            "source": "ReleaseEmbeddedValidatedObservationRule",
            "executionContext": "InProcessValidatedAssessmentRecord", "privilege": "NoElevation",
            "networkBehavior": "OfflineOnly", "executable": "NoneInProcess", "dependencies": [],
            "mayPrompt": false, "mayInstall": false, "mayDownload": false,
            "maySelfElevate": false, "writesAllowed": false, "maximumAttempts": 1,
            "deadlineMilliseconds": 100, "maximumInputObservations": 6,
            "maximumOutputFindings": 1, "cleanup": "NoArtifacts",
            "missingEvidenceOutcome": "Indeterminate"
          },
          {
            "findingKind": "power-context", "ruleId": "rule:device.power-context/1.0.0",
            "operationId": "op:rule.device-power-context.evaluate",
            "source": "ReleaseEmbeddedValidatedObservationRule",
            "executionContext": "InProcessValidatedAssessmentRecord", "privilege": "NoElevation",
            "networkBehavior": "OfflineOnly", "executable": "NoneInProcess", "dependencies": [],
            "mayPrompt": false, "mayInstall": false, "mayDownload": false,
            "maySelfElevate": false, "writesAllowed": false, "maximumAttempts": 1,
            "deadlineMilliseconds": 100, "maximumInputObservations": 4,
            "maximumOutputFindings": 1, "cleanup": "NoArtifacts",
            "missingEvidenceOutcome": "Indeterminate"
          }
        ],
        "fieldIds": [
          "field:device.manufacturer", "field:device.model", "field:device.processor.name",
          "field:device.memory.physical-bytes", "field:device.windows.edition",
          "field:device.windows.build", "field:device.architecture",
          "field:device.windows.activation-state", "field:device.system-type-code",
          "field:device.hypervisor-present", "field:device.chassis.type-codes",
          "field:device.virtualization.detected", "field:device.form-factor",
          "field:device.battery.presence", "field:device.battery.status",
          "field:device.battery.charge-percent",
          "field:device.battery.estimated-runtime-minutes"
        ],
        "validationScenarios": ["Complete", "Partial", "Unavailable", "Malformed", "Oversize", "Virtual", "Unicode", "NonEnglish", "Activated", "Physical", "Desktop", "BatteryAbsent", "Unactivated", "Laptop", "BatteryPresent", "BatteryUnavailable", "Denied", "ProhibitedMaterial"]
      }
    },
    "privilege": {
      "type": "object",
      "additionalProperties": false,
      "required": ["elevationRequired", "maximumUacInteractions", "standardUserPreparation", "privilegedOperationsFrozen", "systemContext", "laterPromptsAllowed", "approvalBoundary", "elevationConsent", "elevationPromptAfterApprovalAllowed", "privilegedOperations"],
      "properties": {
        "elevationRequired": { "const": true },
        "maximumUacInteractions": { "const": 1 },
        "standardUserPreparation": { "const": true },
        "privilegedOperationsFrozen": { "const": true },
        "systemContext": { "const": "PredefinedRequiredOperationsOnly" },
        "laterPromptsAllowed": { "const": false },
        "approvalBoundary": { "const": "PreparationSummary" },
        "elevationConsent": { "const": "IncludedInPreparationApproval" },
        "elevationPromptAfterApprovalAllowed": { "const": false },
        "privilegedOperations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/operation" }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime", "builtInModulesOnly", "installations", "agreements"],
      "properties": {
        "runtime": { "const": "Stable PowerShell 7.6 or later 7.x" },
        "builtInModulesOnly": { "const": true },
        "installations": { "type": "array", "maxItems": 0 },
        "agreements": { "type": "array", "maxItems": 0 }
      }
    },
    "estimates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["durationMinutes", "workspaceDiskMiB", "protectedPackageDiskMiB"],
      "properties": {
        "durationMinutes": { "type": "integer", "minimum": 1 },
        "workspaceDiskMiB": { "type": "integer", "minimum": 1 },
        "protectedPackageDiskMiB": { "type": "integer", "minimum": 1 }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["behavior", "automaticTelemetry", "authenticatedCloudCollection", "plannedRequests"],
      "properties": {
        "behavior": { "enum": ["LocalOnly", "MicrosoftConnectivityEnabled"] },
        "automaticTelemetry": { "const": false },
        "authenticatedCloudCollection": { "const": false },
        "plannedRequests": {
          "type": "array",
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["protocol", "purpose"],
            "properties": {
              "protocol": { "enum": ["DNS", "TCP-TLS-HTTP"] },
              "purpose": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedDestination", "destination", "protection", "recipientProfile"],
      "properties": {
        "requestedDestination": { "type": "string", "minLength": 1 },
        "destination": { "type": "string", "minLength": 1 },
        "protection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "plaintextSharingArtifactAllowed"],
          "properties": {
            "mode": { "const": "LocalPackageProtector" },
            "plaintextSharingArtifactAllowed": { "const": false }
          }
        },
        "recipientProfile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "selectedBeforeCollection", "maximumRecipients", "label", "fingerprint", "protectionLevel", "profileValidated", "fingerprintConfirmed"],
          "properties": {
            "mode": { "enum": ["None", "Profile"] },
            "selectedBeforeCollection": { "const": true },
            "maximumRecipients": { "const": 1 },
            "label": { "type": ["string", "null"], "minLength": 1, "maxLength": 80 },
            "fingerprint": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
            "protectionLevel": { "type": ["string", "null"], "enum": [null, "UserAndDeviceBound", "WindowsUserBound"] },
            "profileValidated": { "type": "boolean" },
            "fingerprintConfirmed": { "type": "boolean" }
          },
          "allOf": [
            {
              "if": { "properties": { "mode": { "const": "None" } } },
              "then": {
                "properties": {
                  "label": { "type": "null" },
                  "fingerprint": { "type": "null" },
                  "protectionLevel": { "type": "null" },
                  "profileValidated": { "const": true },
                  "fingerprintConfirmed": { "const": false }
                }
              },
              "else": {
                "properties": {
                  "label": { "type": "string" },
                  "fingerprint": { "type": "string" },
                  "protectionLevel": { "type": "string" },
                  "profileValidated": { "const": true },
                  "fingerprintConfirmed": { "const": true }
                }
              }
            }
          ]
        }
      }
    },
    "windowsFeatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationsPlanned", "changes"],
      "properties": {
        "observationsPlanned": { "const": true },
        "changes": { "type": "array", "maxItems": 0 }
      }
    },
    "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "sideEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["performedDuringPreparation", "afterApproval", "deviceConfigurationChanges"],
      "properties": {
        "performedDuringPreparation": { "const": false },
        "afterApproval": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "deviceConfigurationChanges": { "type": "array", "maxItems": 0 }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredAfterExecution", "planned", "staleRunRecovery"],
      "properties": {
        "requiredAfterExecution": { "const": true },
        "planned": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "staleRunRecovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "mode", "collectionResumeAllowed"],
          "properties": {
            "requested": { "type": "boolean" },
            "mode": { "const": "CleanupOnly" },
            "collectionResumeAllowed": { "const": false }
          }
        }
      }
    },
    "governingResources": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/definitions/resource" }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["embeddedDefinitionSha256", "applicationManifestSha256", "applicationResources"],
      "properties": {
        "embeddedDefinitionSha256": { "$ref": "#/definitions/digest" },
        "applicationManifestSha256": { "$ref": "#/definitions/digest" },
        "applicationResources": {
          "type": "array",
          "minItems": 10,
          "items": { "$ref": "#/definitions/resource" }
        }
      }
    }
  },
  "definitions": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/definitions/digest" }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "capabilityId", "kind", "phase", "context", "network"],
      "properties": {
        "operationId": { "type": "string", "minLength": 1 },
        "capabilityId": { "pattern": "^CAP-[0-9]{4}$" },
        "kind": { "enum": ["Collection", "RunControl", "ReleaseControl"] },
        "phase": { "type": "string", "minLength": 1 },
        "context": { "enum": ["StandardUser", "Administrator", "LocalSystem", "NotApplicable"] },
        "network": { "enum": ["None", "MicrosoftConnectivityEnabledOnly"] }
      }
    }
  }
}
