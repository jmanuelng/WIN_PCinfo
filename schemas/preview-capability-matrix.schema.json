{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmanuelng/WIN_PCinfo/schemas/preview-capability-matrix.schema.json",
  "title": "WIN-PCInfo derived Preview Capability Matrix projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType",
    "contractVersion",
    "state",
    "reasonCode",
    "handEdited",
    "derivedFromFrozenLedger",
    "ledgerSchemaVersion",
    "release",
    "supportClaim",
    "previewOrStableClaim",
    "rows",
    "scenarioSnapshots",
    "limitations"
  ],
  "properties": {
    "recordType": { "const": "win-pcinfo.preview-capability-matrix" },
    "contractVersion": { "const": "1.0.0" },
    "state": { "enum": ["Derived", "Rejected"] },
    "reasonCode": { "type": "string", "pattern": "^GATE\\.[A-Z0-9_]+$" },
    "handEdited": { "const": false },
    "derivedFromFrozenLedger": { "type": "boolean" },
    "ledgerSchemaVersion": { "type": ["integer", "null"], "minimum": 1, "maximum": 32 },
    "release": { "const": "2.0.0-preview.1" },
    "supportClaim": { "const": "None" },
    "previewOrStableClaim": { "const": "None" },
    "rows": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capabilityId",
          "name",
          "scenarioId",
          "supportState",
          "evidenceResult",
          "reasonCode",
          "limitations"
        ],
        "properties": {
          "capabilityId": { "type": "string", "pattern": "^CAP-[0-9]{4}$" },
          "name": { "type": "string", "minLength": 4, "maxLength": 128 },
          "scenarioId": {
            "enum": [
              "windows-10-enterprise-x64",
              "windows-11-enterprise-x64"
            ]
          },
          "supportState": {
            "enum": ["Preview", "NotYetSupported", "Mixed"]
          },
          "evidenceResult": {
            "enum": [
              "Pass",
              "ProductFail",
              "InfrastructureInconclusive",
              "NotRun",
              "Expired",
              "Invalidated"
            ]
          },
          "reasonCode": { "type": "string", "pattern": "^GATE\\.[A-Z0-9_]+$" },
          "limitations": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "string", "minLength": 4, "maxLength": 96 }
          }
        }
      }
    },
    "scenarioSnapshots": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenarioId",
          "windowsFamily",
          "edition",
          "architecture",
          "supportState",
          "evidenceResult",
          "reasonCode",
          "method",
          "limitations"
        ],
        "properties": {
          "scenarioId": {
            "enum": [
              "windows-10-enterprise-x64",
              "windows-11-enterprise-x64"
            ]
          },
          "windowsFamily": { "enum": ["Windows 10", "Windows 11"] },
          "edition": { "const": "Enterprise" },
          "architecture": { "const": "x64" },
          "supportState": {
            "enum": ["Preview", "NotYetSupported"]
          },
          "evidenceResult": {
            "enum": [
              "Pass",
              "ProductFail",
              "InfrastructureInconclusive",
              "NotRun",
              "Expired",
              "Invalidated"
            ]
          },
          "reasonCode": { "type": "string", "pattern": "^GATE\\.[A-Z0-9_]+$" },
          "method": {
            "enum": [
              "ClientVmValidation",
              "PhysicalValidation",
              "CommunityValidation",
              "None"
            ]
          },
          "limitations": {
            "type": "array",
            "maxItems": 16,
            "items": { "type": "string", "minLength": 4, "maxLength": 96 }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 4, "maxLength": 96 }
    }
  }
}
