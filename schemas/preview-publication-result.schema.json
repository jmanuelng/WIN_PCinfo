{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmanuelng/WIN_PCinfo/schemas/preview-publication-result.schema.json",
  "title": "WIN-PCInfo sanitized Preview publication result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType",
    "contractVersion",
    "state",
    "decision",
    "reasonCode",
    "syntheticEvidenceOnly",
    "supportClaim",
    "previewOrStableClaim",
    "sliceDeliversCapability",
    "publicationAuthorized",
    "githubReleaseCreated",
    "humanApprovalRequired",
    "humanApprovalPresent",
    "tagImmutable",
    "silentReplacementAttempted",
    "candidateBound",
    "qualificationApproved",
    "assetsVerified",
    "downloadVerified",
    "collectionStarted",
    "trustPath",
    "attestedPreviewSatisfiesStableSigning",
    "smokes",
    "blockingReasons",
    "limitations"
  ],
  "properties": {
    "recordType": { "const": "win-pcinfo.preview-publication-result" },
    "contractVersion": { "const": "1.0.0" },
    "state": {
      "enum": ["Previewed", "PublishedAndVerified", "Denied", "Rejected"]
    },
    "decision": {
      "enum": ["AwaitingHumanApproval", "Publish", "Deny", "NotStarted"]
    },
    "reasonCode": {
      "type": "string",
      "pattern": "^PUBLISH\\.[A-Z0-9_]+$"
    },
    "syntheticEvidenceOnly": { "type": "boolean" },
    "supportClaim": { "const": "None" },
    "previewOrStableClaim": { "const": "None" },
    "sliceDeliversCapability": { "const": false },
    "publicationAuthorized": { "const": false },
    "githubReleaseCreated": { "const": false },
    "humanApprovalRequired": { "const": true },
    "humanApprovalPresent": { "type": "boolean" },
    "tagImmutable": { "const": true },
    "silentReplacementAttempted": { "type": "boolean" },
    "candidateBound": { "type": "boolean" },
    "qualificationApproved": { "type": "boolean" },
    "assetsVerified": { "type": "boolean" },
    "downloadVerified": { "type": "boolean" },
    "collectionStarted": { "const": false },
    "trustPath": {
      "enum": ["AuthenticodeSigned", "AttestedPreview", "None"]
    },
    "attestedPreviewSatisfiesStableSigning": { "const": false },
    "smokes": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["smokeId", "result", "reasonCode"],
        "properties": {
          "smokeId": {
            "enum": [
              "trust",
              "launch",
              "download",
              "runtime-guidance",
              "beginner-instructions",
              "package-resources"
            ]
          },
          "result": {
            "enum": [
              "Pass",
              "ProductFail",
              "InfrastructureInconclusive",
              "NotRun",
              "Expired",
              "Invalidated"
            ]
          },
          "reasonCode": {
            "type": "string",
            "pattern": "^PUBLISH\\.[A-Z0-9_]+$"
          }
        }
      }
    },
    "blockingReasons": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^PUBLISH\\.[A-Z0-9_]+$"
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 32,
      "items": { "type": "string", "minLength": 4, "maxLength": 96 }
    }
  }
}
