{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmanuelng/WIN_PCinfo/schemas/assessment-record.schema.json",
  "title": "WIN-PCInfo Assessment Record tracer-bullet contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType",
    "contractVersion",
    "requiredFeatures",
    "run",
    "subjects",
    "provenance",
    "observations",
    "coverage",
    "diagnostics",
    "collectorResults",
    "findings",
    "recommendations",
    "recommendationRelationships"
  ],
  "properties": {
    "recordType": { "const": "win-pcinfo.assessment-record" },
    "contractVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "requiredFeatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runId", "outcome", "validationFixture"],
      "properties": {
        "runId": { "$ref": "#/$defs/id" },
        "outcome": { "enum": ["Completed", "CompletedWithGaps", "NotStarted", "Cancelled", "TimedOut", "IntegrityFailed", "CleanupIncomplete"] },
        "validationFixture": { "type": "boolean" },
        "evidenceProfileId": { "enum": ["profile:synthetic-contract-tracer", "profile:device-windows-readiness", "profile:device-windows-context", "profile:device-and-firmware-readiness", "profile:device-firmware-and-identity-readiness", "profile:device-firmware-identity-and-administrator-readiness", "profile:device-firmware-identity-administrator-and-policy-readiness", "profile:device-firmware-identity-administrator-policy-and-resource-dependencies", "profile:device-firmware-identity-administrator-policy-resource-and-network-readiness", "profile:device-firmware-identity-administrator-policy-software-resource-and-network-readiness", "profile:device-firmware-identity-administrator-policy-software-resource-network-and-certificate-trust-readiness", "profile:device-firmware-identity-administrator-policy-software-resource-network-certificate-and-microsoft-connectivity-readiness"] }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subjectId", "kind"],
        "properties": {
          "subjectId": { "$ref": "#/$defs/id" },
          "kind": { "enum": ["Device", "User", "SecurityPrincipal", "PolicyObject", "Application", "Certificate", "CertificatePurpose", "Interface", "OtherSynthetic"] }
        }
      }
    },
    "provenance": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6144,
      "items": { "$ref": "#/$defs/provenance" }
    },
    "observations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 6144,
      "items": { "$ref": "#/$defs/observation" }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/coverage" }
    },
    "diagnostics": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "collectorResults": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/collectorEnvelope" }
    },
    "findings": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/finding" }
    },
    "recommendations": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/recommendation" }
    },
    "recommendationRelationships": {
      "type": "array",
      "maxItems": 64,
      "items": { "$ref": "#/$defs/recommendationRelationship" }
    },
    "softwareRecognition": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/softwareRecognitionAnnotation" }
    }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9._:/-]*$" },
    "reasonCode": { "type": "string", "minLength": 3, "maxLength": 96, "pattern": "^[A-Z][A-Z0-9_]*(?:\\.[A-Z][A-Z0-9_]*)+$" },
    "timestamp": { "type": "string", "format": "date-time" },
    "idArray": {
      "type": "array",
      "maxItems": 6144,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/id" }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provenanceId", "fieldId", "subjectId", "sourceId", "collectorId", "collectorVersion", "executionContext", "collectedAt", "sourceLocale"],
      "properties": {
        "provenanceId": { "$ref": "#/$defs/id" },
        "fieldId": { "$ref": "#/$defs/id" },
        "subjectId": { "$ref": "#/$defs/id" },
        "sourceId": { "$ref": "#/$defs/id" },
        "collectorId": { "$ref": "#/$defs/id" },
        "collectorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "executionContext": { "enum": ["Synthetic", "StandardUser", "Administrator", "LocalSystem", "InProcessValidatedAssessmentRecord"] },
        "collectedAt": { "$ref": "#/$defs/timestamp" },
        "sourceLocale": { "type": "string", "minLength": 2, "maxLength": 35 }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "fieldId", "subjectId", "provenanceId", "valueState"],
      "properties": {
        "observationId": { "$ref": "#/$defs/id" },
        "fieldId": { "$ref": "#/$defs/id" },
        "subjectId": { "$ref": "#/$defs/id" },
        "provenanceId": { "$ref": "#/$defs/id" },
        "valueState": { "enum": ["ObservedValue", "ObservedAbsent", "SourceReportedUnknown"] },
        "value": { "type": ["string", "boolean", "integer"] }
      },
      "dependentSchemas": {
        "value": { "properties": { "valueState": { "const": "ObservedValue" } } }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coverageId", "scopeId", "state", "observationIds", "diagnosticIds"],
      "properties": {
        "coverageId": { "$ref": "#/$defs/id" },
        "scopeId": { "$ref": "#/$defs/id" },
        "state": { "enum": ["Complete", "Partial", "NotApplicable", "Unavailable", "Constrained", "Unsupported", "Denied", "Malformed", "TimedOut", "Cancelled", "ProhibitedMaterialBlocked", "Failed", "NotAttempted"] },
        "reasonCode": { "$ref": "#/$defs/reasonCode" },
        "observationIds": { "$ref": "#/$defs/idArray" },
        "diagnosticIds": { "$ref": "#/$defs/idArray" }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagnosticId", "scopeId", "phase", "reasonCode", "operatorMessageId"],
      "properties": {
        "diagnosticId": { "$ref": "#/$defs/id" },
        "scopeId": { "$ref": "#/$defs/id" },
        "phase": { "enum": ["Collection", "Interpretation", "Protection", "Packaging", "Cleanup"] },
        "reasonCode": { "$ref": "#/$defs/reasonCode" },
        "operatorMessageId": { "$ref": "#/$defs/id" },
        "prohibitedMaterial": {
          "type": "object",
          "additionalProperties": false,
          "required": ["encountered", "retained", "hashed"],
          "properties": {
            "encountered": { "const": true },
            "retained": { "const": false },
            "hashed": { "const": false }
          }
        }
      }
    },
    "collectorEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelopeId", "collectorId", "collectorVersion", "operationId", "intendedScopeIds", "subjectIds", "startedAt", "completedAt", "executionContext", "attempts", "observationIds", "coverageIds", "diagnosticIds"],
      "properties": {
        "envelopeId": { "$ref": "#/$defs/id" },
        "collectorId": { "$ref": "#/$defs/id" },
        "collectorVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "operationId": { "$ref": "#/$defs/id" },
        "intendedScopeIds": { "$ref": "#/$defs/idArray" },
        "subjectIds": { "$ref": "#/$defs/idArray" },
        "startedAt": { "$ref": "#/$defs/timestamp" },
        "completedAt": { "$ref": "#/$defs/timestamp" },
        "executionContext": { "enum": ["Synthetic", "StandardUser", "Administrator", "LocalSystem", "InProcessValidatedAssessmentRecord"] },
        "attempts": { "type": "integer", "minimum": 1, "maximum": 3 },
        "observationIds": { "$ref": "#/$defs/idArray" },
        "coverageIds": { "$ref": "#/$defs/idArray" },
        "diagnosticIds": { "$ref": "#/$defs/idArray" }
      }
    },
    "evidenceReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observationId", "fieldId", "subjectId"],
      "properties": {
        "observationId": { "$ref": "#/$defs/id" },
        "fieldId": { "$ref": "#/$defs/id" },
        "subjectId": { "$ref": "#/$defs/id" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "ruleId", "targetSubjectId", "outcome", "evidenceReferences"],
      "properties": {
        "findingId": { "$ref": "#/$defs/id" },
        "ruleId": { "$ref": "#/$defs/id" },
        "targetSubjectId": { "$ref": "#/$defs/id" },
        "outcome": { "enum": ["ExpectedCondition", "NeedsAttention", "Informational", "Indeterminate", "NotApplicable"] },
        "reasonCode": { "$ref": "#/$defs/reasonCode" },
        "evidenceReferences": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/evidenceReference" }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendationId", "definitionId", "kind", "findingIds"],
      "properties": {
        "recommendationId": { "$ref": "#/$defs/id" },
        "definitionId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["AssessmentRecommendation", "TenantSideDiscoveryTask"] },
        "findingIds": { "$ref": "#/$defs/idArray" }
      }
    },
    "recommendationRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationshipId", "fromRecommendationId", "toRecommendationId", "kind"],
      "properties": {
        "relationshipId": { "$ref": "#/$defs/id" },
        "fromRecommendationId": { "$ref": "#/$defs/id" },
        "toRecommendationId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["Requires", "Enables", "ConflictsWith"] }
      }
    },
    "softwareRecognitionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "owner", "url", "verifiedOn", "reviewer", "pinnedCommit", "manifestPath"],
      "properties": {
        "sourceType": { "enum": ["PrimaryPublisherDocumentation", "ControlledFreshInstallation", "PinnedWinGetManifest"] },
        "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
        "url": { "type": "string", "format": "uri", "pattern": "^https://", "maxLength": 2048 },
        "verifiedOn": { "type": "string", "format": "date" },
        "reviewer": { "type": "string", "minLength": 1, "maxLength": 128 },
        "pinnedCommit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
        "manifestPath": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 }
      }
    },
    "softwareRecognitionAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["annotationId", "subjectId", "outcome", "familyId", "familyLabel", "roles", "matcherIds", "matcherTypes", "matchStrengthExplanation", "reasonCode", "catalogRevision", "catalogRelease", "catalogDigest", "provenance"],
      "properties": {
        "annotationId": { "$ref": "#/$defs/id" },
        "subjectId": { "$ref": "#/$defs/id" },
        "outcome": { "enum": ["RecognizedExact", "RecognizedComposite", "Ambiguous", "Unrecognized", "NotEvaluated"] },
        "familyId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "familyLabel": { "type": ["string", "null"], "minLength": 1, "maxLength": 128 },
        "roles": { "type": "array", "maxItems": 8, "uniqueItems": true, "items": { "enum": ["EndpointSecurity", "DeviceManagement", "VpnOrZeroTrustNetworkAccess", "DataLossPrevention", "Encryption", "RemoteSupport", "AuthenticationOrCredentialProvider", "Browser", "PatchOrUpdateAgent", "BackupOrRecoveryAgent", "OtherMigrationDependency"] } },
        "matcherIds": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "matcherTypes": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "enum": ["ExactPackageFamilyName", "ExactMsiProductCode", "ExactMsiUpgradeCode", "CompositeRegistration"] } },
        "matchStrengthExplanation": { "type": "string", "minLength": 1, "maxLength": 512 },
        "reasonCode": { "anyOf": [{ "$ref": "#/$defs/reasonCode" }, { "type": "null" }] },
        "catalogRevision": { "type": "integer", "minimum": 0 },
        "catalogRelease": { "const": "2.0.0-preview.1" },
        "catalogDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "provenance": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/softwareRecognitionSource" } }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "enum": ["RecognizedExact", "RecognizedComposite"] } } },
          "then": {
            "properties": {
              "familyId": { "$ref": "#/$defs/id" },
              "familyLabel": { "type": "string" },
              "roles": { "minItems": 1 },
              "matcherIds": { "minItems": 1 },
              "matcherTypes": { "minItems": 1 },
              "reasonCode": { "type": "null" },
              "catalogRevision": { "minimum": 1 },
              "provenance": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "enum": ["Ambiguous", "Unrecognized", "NotEvaluated"] } } },
          "then": {
            "properties": {
              "familyId": { "type": "null" },
              "familyLabel": { "type": "null" },
              "roles": { "maxItems": 0 },
              "reasonCode": { "$ref": "#/$defs/reasonCode" },
              "provenance": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
