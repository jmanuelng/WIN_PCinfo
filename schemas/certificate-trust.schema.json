{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/jmanuelng/WIN_PCinfo/schemas/certificate-trust.schema.json",
  "title":"WIN-PCInfo purpose-bound certificate and trust policy",
  "type":"object","additionalProperties":false,
  "required":["kind","contractVersion","release","policyId","evidenceProfileId","collector","purposes","fieldIds","rules","recommendations","validationScenarios"],
  "properties":{
    "kind":{"const":"win-pcinfo.certificate-trust-policy"},
    "contractVersion":{"const":"1.0.0"},
    "release":{"const":"2.0.0-preview.1"},
    "policyId":{"const":"win-pcinfo.certificate-trust/1.0.0"},
    "evidenceProfileId":{"const":"profile:device-firmware-identity-administrator-policy-software-resource-network-and-certificate-trust-readiness"},
    "collector":{"$ref":"#/$defs/operation"},
    "purposes":{"type":"array","minItems":6,"maxItems":6,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["purposeId","scopeId","sourceId","stores","ekuOids","limitation"],"properties":{"purposeId":{"enum":["Management","Authentication","DeviceIdentity","CodeTrust","TlsInspection","ServiceConnectivity"]},"scopeId":{"pattern":"^scope:certificate\\."},"sourceId":{"const":"source:windows.certificate-store.purpose-selected"},"stores":{"type":"array","maxItems":2,"uniqueItems":true,"items":{"enum":["CurrentUser/My","LocalMachine/My","CurrentUser/TrustedPublisher","LocalMachine/TrustedPublisher"]}},"ekuOids":{"type":"array","maxItems":2,"uniqueItems":true,"items":{"pattern":"^[0-9]+(?:\\.[0-9]+)+$"}},"limitation":{"type":"string","minLength":40,"maxLength":256}}}},
    "fieldIds":{"const":["field:certificate.presence","field:certificate.purpose","field:certificate.identifier","field:certificate.fingerprint","field:certificate.store-location","field:certificate.store-name","field:certificate.not-before","field:certificate.not-after","field:certificate.validity-state","field:certificate.chain-state","field:certificate.trust-state","field:certificate.key-protection-state"]},
    "rules":{"type":"array","minItems":4,"maxItems":4,"items":{"$ref":"#/$defs/rule"}},
    "recommendations":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["definitionId","findingKind","purpose"],"properties":{"definitionId":{"$ref":"#/$defs/id"},"findingKind":{"enum":["certificate-presence","certificate-validity","certificate-trust"]},"purpose":{"type":"string","minLength":40,"maxLength":256}}}},
    "validationScenarios":{"const":["ValidTrusted","Expired","NotYetValid","Untrusted","IncompleteChain","MultipleCandidates","InaccessibleStore","AbsentPurpose","NonExportableKey","AlternateAdministrator","VirtualDevice","MalformedCertificate"]}
  },
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":128,"pattern":"^[A-Za-z][A-Za-z0-9._:/-]*$"},
    "operation":{"type":"object","additionalProperties":false,"required":["collectorId","collectorVersion","operationId","source","executionContext","privilege","networkBehavior","executable","dependencies","mayPrompt","mayInstall","mayDownload","maySelfElevate","writesAllowed","maximumAttempts","deadlineMilliseconds","resultMaximumUtf8Bytes","maximumCertificatesPerPurpose","cleanup"],"properties":{"collectorId":{"const":"collector:windows.purpose-bound-certificate-trust"},"collectorVersion":{"const":"1.0.0"},"operationId":{"const":"observe-certificate-trust"},"source":{"type":"string","minLength":60,"maxLength":256},"executionContext":{"const":"StandardUser"},"privilege":{"const":"NoElevation"},"networkBehavior":{"const":"OfflineOnly"},"executable":{"const":"ActiveMicrosoftSignedPowerShellHost"},"dependencies":{"const":["System.Security.Cryptography.X509Certificates"]},"mayPrompt":{"const":false},"mayInstall":{"const":false},"mayDownload":{"const":false},"maySelfElevate":{"const":false},"writesAllowed":{"const":false},"maximumAttempts":{"const":1},"deadlineMilliseconds":{"const":30000},"resultMaximumUtf8Bytes":{"const":131072},"maximumCertificatesPerPurpose":{"const":8},"cleanup":{"const":"CoordinatorOwnedJobObjectWorkerAndStoresClosedVerifiedAbsent"}}},
    "rule":{"type":"object","additionalProperties":false,"required":["findingKind","ruleId","operationId","source","executionContext","privilege","networkBehavior","executable","dependencies","mayPrompt","mayInstall","mayDownload","maySelfElevate","writesAllowed","maximumAttempts","deadlineMilliseconds","maximumInputObservations","maximumOutputFindings","cleanup","missingEvidenceOutcome"],"properties":{"findingKind":{"enum":["certificate-presence","certificate-validity","certificate-trust","certificate-key-protection"]},"ruleId":{"$ref":"#/$defs/id"},"operationId":{"$ref":"#/$defs/id"},"source":{"const":"ReleaseEmbeddedValidatedObservationRule"},"executionContext":{"const":"InProcessValidatedAssessmentRecord"},"privilege":{"const":"NoElevation"},"networkBehavior":{"const":"OfflineOnly"},"executable":{"const":"NoneInProcess"},"dependencies":{"const":[]},"mayPrompt":{"const":false},"mayInstall":{"const":false},"mayDownload":{"const":false},"maySelfElevate":{"const":false},"writesAllowed":{"const":false},"maximumAttempts":{"const":1},"deadlineMilliseconds":{"const":100},"maximumInputObservations":{"type":"integer","minimum":1,"maximum":128},"maximumOutputFindings":{"const":6},"cleanup":{"const":"NoArtifacts"},"missingEvidenceOutcome":{"const":"Indeterminate"}}}
  }
}
