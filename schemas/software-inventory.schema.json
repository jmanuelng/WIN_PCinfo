{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmanuelng/WIN_PCinfo/schemas/software-inventory.schema.json",
  "title": "WIN-PCInfo Software Inventory release policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind","contractVersion","release","policyId","evidenceProfileId","registrationContexts","registryViews","collector","sourceCatalog","scopes","rules","recommendations","validationScenarios"],
  "properties": {
    "kind": {"const":"win-pcinfo.software-inventory-policy"},
    "contractVersion": {"const":"1.0.0"},
    "release": {"const":"2.0.0-preview.1"},
    "policyId": {"const":"win-pcinfo.software-inventory/1.0.0"},
    "evidenceProfileId": {"const":"profile:device-firmware-identity-administrator-policy-software-resource-and-network-readiness"},
    "registrationContexts": {"const":["Machine","AssessmentUser"]},
    "registryViews": {"const":["Registry32","Registry64"]},
    "collector": {"$ref":"#/$defs/collector"},
    "sourceCatalog": {"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/source"}},
    "scopes": {"type":"array","minItems":8,"maxItems":8,"items":{"$ref":"#/$defs/scope"}},
    "rules": {"type":"array","minItems":3,"maxItems":3,"items":{"$ref":"#/$defs/rule"}},
    "recommendations": {"type":"array","minItems":2,"maxItems":2,"items":{"$ref":"#/$defs/recommendation"}},
    "validationScenarios": {"const":["RegistryViews","UserAndMachine","MsiStates","PackageTypes","Duplicates","ArbitraryVersions","Malformed","Oversize","AggregateMaximum","DeniedAllUsers","DeniedUser","Unicode","Empty","AlternateAdministrator","LocalSystem","Partial"]}
  },
  "$defs": {
    "id": {"type":"string","minLength":1,"maxLength":160,"pattern":"^[A-Za-z][A-Za-z0-9._:/-]*$"},
    "collector": {
      "type":"object","additionalProperties":false,
      "required":["collectorId","collectorVersion","operationId","source","executionContext","privilege","networkBehavior","executable","dependencies","mayPrompt","mayInstall","mayDownload","maySelfElevate","writesAllowed","maximumAttempts","deadlineMilliseconds","resultMaximumUtf8Bytes","maximumEntriesPerScope","maximumTotalEntries","cleanup"],
      "properties": {
        "collectorId":{"const":"collector:windows.software-inventory"},"collectorVersion":{"const":"1.0.0"},"operationId":{"const":"observe-installed-software"},
        "source":{"type":"string","minLength":40,"maxLength":512},"executionContext":{"const":"StandardUser"},"privilege":{"const":"NoElevation"},"networkBehavior":{"const":"OfflineOnly"},"executable":{"const":"MicrosoftWindowsPowerShellHost"},
        "dependencies":{"const":["Windows PowerShell 5.1","Microsoft.Win32.Registry","Windows Installer API","Windows.Management.Deployment.PackageManager"]},
        "mayPrompt":{"const":false},"mayInstall":{"const":false},"mayDownload":{"const":false},"maySelfElevate":{"const":false},"writesAllowed":{"const":false},
        "maximumAttempts":{"const":1},"deadlineMilliseconds":{"const":10000},"resultMaximumUtf8Bytes":{"const":1048576},"maximumEntriesPerScope":{"const":64},"maximumTotalEntries":{"const":128},"cleanup":{"const":"CoordinatorOwnedJobObjectWorkerAndCompilerBoundaryVerifiedAbsent"}
      }
    },
    "source": {
      "type":"object","additionalProperties":false,"required":["sourceId","interface","approvedProperties","limitation"],
      "properties":{"sourceId":{"$ref":"#/$defs/id"},"interface":{"type":"string","minLength":10,"maxLength":256},"approvedProperties":{"type":"array","minItems":6,"maxItems":8,"uniqueItems":true,"items":{"type":"string","minLength":2,"maxLength":64}},"limitation":{"type":"string","minLength":20,"maxLength":160}}
    },
    "scope": {
      "type":"object","additionalProperties":false,"required":["scopeId","sourceId","fieldIds"],
      "properties":{"scopeId":{"$ref":"#/$defs/id"},"sourceId":{"$ref":"#/$defs/id"},"fieldIds":{"type":"array","minItems":7,"maxItems":9,"uniqueItems":true,"items":{"$ref":"#/$defs/id"}}}
    },
    "rule": {
      "type":"object","additionalProperties":false,"required":["findingKind","ruleId","operationId","source","executionContext","privilege","networkBehavior","executable","dependencies","mayPrompt","mayInstall","mayDownload","maySelfElevate","writesAllowed","maximumAttempts","deadlineMilliseconds","maximumInputObservations","maximumOutputFindings","cleanup","missingEvidenceOutcome"],
      "properties":{"findingKind":{"enum":["machine-software-inventory","assessment-user-software-inventory","software-inventory-coverage"]},"ruleId":{"$ref":"#/$defs/id"},"operationId":{"$ref":"#/$defs/id"},"source":{"const":"ReleaseEmbeddedValidatedObservationRule"},"executionContext":{"const":"InProcessValidatedAssessmentRecord"},"privilege":{"const":"NoElevation"},"networkBehavior":{"const":"OfflineOnly"},"executable":{"const":"NoneInProcess"},"dependencies":{"const":[]},"mayPrompt":{"const":false},"mayInstall":{"const":false},"mayDownload":{"const":false},"maySelfElevate":{"const":false},"writesAllowed":{"const":false},"maximumAttempts":{"const":1},"deadlineMilliseconds":{"const":100},"maximumInputObservations":{"enum":[4096,8192]},"maximumOutputFindings":{"const":1},"cleanup":{"const":"NoArtifacts"},"missingEvidenceOutcome":{"const":"Indeterminate"}}
    },
    "recommendation": {"type":"object","additionalProperties":false,"required":["definitionId","findingKind","purpose","prerequisites","caution","responsibleRole","verification","authoritativeReferences"],"properties":{"definitionId":{"$ref":"#/$defs/id"},"findingKind":{"enum":["machine-software-inventory","assessment-user-software-inventory"]},"purpose":{"type":"string","minLength":40,"maxLength":240},"prerequisites":{"type":"array","minItems":1,"maxItems":4,"items":{"type":"string","minLength":1,"maxLength":512}},"caution":{"type":"string","minLength":1,"maxLength":512},"responsibleRole":{"type":"string","minLength":1,"maxLength":512},"verification":{"type":"string","minLength":1,"maxLength":512},"authoritativeReferences":{"type":"array","minItems":1,"maxItems":4,"items":{"type":"string","pattern":"^https://learn\\.microsoft\\.com/","maxLength":2048}}}}
  }
}
