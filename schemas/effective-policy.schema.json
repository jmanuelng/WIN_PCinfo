{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jmanuelng/WIN_PCinfo/schemas/effective-policy.schema.json",
  "title": "WIN-PCInfo Effective Policy release policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "contractVersion", "release", "policyId", "evidenceProfileId", "layers", "collectors", "sourceCatalog", "auditSubcategories", "userRights", "securityOptions", "userRightSemantics", "localAccountPolicySemantics", "scopes", "rules", "validationScenarios"],
  "properties": {
    "kind": { "const": "win-pcinfo.effective-policy-policy" },
    "contractVersion": { "const": "1.0.0" },
    "release": { "const": "2.0.0-preview.1" },
    "policyId": { "const": "win-pcinfo.effective-policy/1.0.0" },
    "evidenceProfileId": { "const": "profile:device-firmware-identity-administrator-and-policy-readiness" },
    "layers": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/layer" } },
    "collectors": { "type": "array", "minItems": 1, "maxItems": 1, "prefixItems": [{ "$ref": "#/$defs/collector" }], "items": false },
    "sourceCatalog": { "type": "array", "minItems": 5, "maxItems": 5, "items": { "$ref": "#/$defs/source" } },
    "auditSubcategories": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/catalogPair" } },
    "userRights": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/right" } },
    "securityOptions": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/securityOption" } },
    "userRightSemantics": { "const": "DirectAssignmentsOnly" },
    "localAccountPolicySemantics": { "const": "LocalSamAccountsOnly" },
    "scopes": { "type": "array", "minItems": 15, "maxItems": 15, "items": { "$ref": "#/$defs/scope" } },
    "rules": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/rule" } },
    "validationScenarios": { "const": ["Workgroup", "Domain", "UserAndComputerRsop", "MissingRsop", "StaleRegistry", "DeniedAdministrator", "DeniedSystem", "NonEnglish", "AppliedOrderConflict", "AccountLockout", "AuditPolicy", "UserRights", "SecurityOptions", "PartialChannel"] }
  },
  "$defs": {
    "layer": {
      "type": "object", "additionalProperties": false, "required": ["layerId", "purpose", "scopeIds"],
      "properties": {
        "layerId": { "enum": ["AppliedPolicyEvidence", "ConfiguredPolicySignals", "CurrentControlState"] },
        "purpose": { "type": "string", "minLength": 20, "maxLength": 512 },
        "scopeIds": { "type": "array", "minItems": 3, "maxItems": 8, "uniqueItems": true, "items": { "type": "string", "pattern": "^scope:policy\\." } }
      }
    },
    "collector": {
      "type": "object", "additionalProperties": false,
      "required": ["collectorId", "collectorVersion", "operationId", "source", "executionContext", "privilege", "networkBehavior", "executable", "dependencies", "mayPrompt", "mayInstall", "mayDownload", "maySelfElevate", "writesAllowed", "maximumAttempts", "deadlineMilliseconds", "resultMaximumUtf8Bytes", "maximumAppliedPoliciesPerTarget", "maximumPolicySettingsPerTarget", "maximumPrincipalsPerRight", "cleanup"],
      "properties": {
        "collectorId": { "const": "collector:windows.effective-policy" }, "collectorVersion": { "const": "1.0.0" },
        "operationId": { "const": "observe-effective-policy" },
        "source": { "const": "Release-owned projection of cached RSoP WMI, local NetAPI, Audit Policy, LSA Policy, and exact local registry values" },
        "executionContext": { "const": "Administrator" }, "privilege": { "const": "RequiresAdministrator" },
        "networkBehavior": { "const": "OfflineOnly" }, "executable": { "const": "ActiveMicrosoftSignedPowerShellHost" },
        "dependencies": { "const": ["Windows RSoP WMI provider", "Netapi32.dll", "Advapi32.dll", "Microsoft.Win32.Registry"] },
        "mayPrompt": { "const": false }, "mayInstall": { "const": false }, "mayDownload": { "const": false },
        "maySelfElevate": { "const": false }, "writesAllowed": { "const": false }, "maximumAttempts": { "const": 1 },
        "deadlineMilliseconds": { "const": 5000 }, "resultMaximumUtf8Bytes": { "const": 16384 },
        "maximumAppliedPoliciesPerTarget": { "const": 8 }, "maximumPolicySettingsPerTarget": { "const": 8 },
        "maximumPrincipalsPerRight": { "const": 8 }, "cleanup": { "const": "CoordinatorOwnedJobObjectAndWorkerVerifiedAbsent" }
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["sourceId", "interface", "limitation"],
      "properties": {
        "sourceId": { "type": "string", "pattern": "^source:windows\\." }, "interface": { "type": "string", "minLength": 8, "maxLength": 128 },
        "namespaces": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } },
        "classes": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "string" } },
        "supportedSettingClasses": { "const": ["RSOP_RegistryPolicySetting"] },
        "approvedProperties": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "type": "string" } },
        "limitation": { "type": "string", "minLength": 12, "maxLength": 128 }
      }
    },
    "catalogPair": {
      "type": "object", "additionalProperties": false, "required": ["catalogId", "guid"],
      "properties": { "catalogId": { "type": "string", "pattern": "^audit:" }, "guid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" } }
    },
    "right": {
      "type": "object", "additionalProperties": false, "required": ["catalogId", "nativeName"],
      "properties": { "catalogId": { "type": "string", "pattern": "^right:" }, "nativeName": { "type": "string", "pattern": "^Se[A-Za-z]+Right$" } }
    },
    "securityOption": {
      "type": "object", "additionalProperties": false, "required": ["catalogId", "registryPath", "valueName", "valueType", "fieldId"],
      "properties": {
        "catalogId": { "type": "string", "pattern": "^security-option:" }, "registryPath": { "type": "string", "minLength": 8, "maxLength": 256 },
        "valueName": { "type": "string", "minLength": 1, "maxLength": 64 }, "valueType": { "enum": ["Boolean", "Integer"] },
        "fieldId": { "type": "string", "pattern": "^field:policy\\.security-option\\." }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false, "required": ["scopeId", "fieldIds"],
      "properties": {
        "scopeId": { "type": "string", "pattern": "^scope:policy\\." },
        "fieldIds": { "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true, "items": { "type": "string", "pattern": "^field:policy\\." } }
      }
    },
    "rule": {
      "type": "object", "additionalProperties": false,
      "required": ["findingKind", "ruleId", "operationId", "source", "executionContext", "privilege", "networkBehavior", "executable", "dependencies", "mayPrompt", "mayInstall", "mayDownload", "maySelfElevate", "writesAllowed", "maximumAttempts", "deadlineMilliseconds", "maximumInputObservations", "maximumOutputFindings", "cleanup", "missingEvidenceOutcome"],
      "properties": {
        "findingKind": { "type": "string", "pattern": "^[a-z0-9-]+$" }, "ruleId": { "type": "string", "pattern": "^rule:policy\\." },
        "operationId": { "type": "string", "pattern": "^op:rule\\.policy\\." }, "source": { "const": "ReleaseEmbeddedValidatedObservationRule" },
        "executionContext": { "const": "InProcessValidatedAssessmentRecord" }, "privilege": { "const": "NoElevation" },
        "networkBehavior": { "const": "OfflineOnly" }, "executable": { "const": "NoneInProcess" }, "dependencies": { "const": [] },
        "mayPrompt": { "const": false }, "mayInstall": { "const": false }, "mayDownload": { "const": false },
        "maySelfElevate": { "const": false }, "writesAllowed": { "const": false },
        "maximumAttempts": { "const": 1 }, "deadlineMilliseconds": { "const": 100 },
        "maximumInputObservations": { "type": "integer", "minimum": 1, "maximum": 96 }, "maximumOutputFindings": { "const": 1 },
        "cleanup": { "const": "NoArtifacts" }, "missingEvidenceOutcome": { "const": "Indeterminate" }
      }
    }
  }
}
