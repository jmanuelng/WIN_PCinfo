# Reports containing machine, account, network, and software information
/Config/
/Network/
/AADaccounts/
/LAaccounts/
/NetTestEndpoints/
/Software/
/Battery/
/gpresult.html

# Common local and secret-bearing files
.env
.env.*
*.log

# Reproducible v2 build and test output. These contain no source of truth and
# are recreated by build/Build.ps1 and tests/Run-Tests.ps1.
/artifacts/
/.test-output/

# Instantiated Azure validation workspaces are private. Generic .tf source
# under infra/azure-validation remains public; rendered values, state, locks,
# and provider caches must stay outside the repository.
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform/
.terraform.lock.hcl

# Local Node dependencies used only by the Sandcastle orchestrator.
/node_modules/
/.worktrees/
